---
/**
 * BookLoader - Loading animation placeholder
 * Displays a book flip animation while page loads
 * The actual GIF animation will be provided separately
 */
interface Props {
  /** Optional custom loading text */
  loadingText?: string;
}

const { loadingText = '' } = Astro.props;
---

<div id="book-loader" class="book-loader" aria-label="Loading">
  <div class="book-loader__content">
    <!-- Book animation using the webp animation -->
    <div class="book-loader__book" data-book-animation>
      <img src="/books/pageflip.webp" alt="" class="book-loader__gif" />
    </div>
    
    {loadingText && (
      <p class="book-loader__text">{loadingText}</p>
    )}
  </div>
</div>

<style>
  .book-loader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #fafafa;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 1;
    transition: opacity 0.6s ease, visibility 0.6s ease;
  }

  .book-loader.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .book-loader__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  /* Book animation container */
  .book-loader__book {
    position: relative;
    width: clamp(200px, 40vw, 350px);
    height: auto;
  }

  /* WebP animation */
  .book-loader__gif {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  /* Text */
  .book-loader__text {
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    color: #78716c;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
    .book-loader__book {
      width: clamp(150px, 60vw, 250px);
    }
  }
</style>

<script>
  // Book loader will be hidden after page loads
  // The WebGL reveal will handle the transition
  document.addEventListener('DOMContentLoaded', () => {
    const loader = document.getElementById('book-loader');
    if (loader) {
      // Hide loader after a short delay for smooth transition
      setTimeout(() => {
        loader.classList.add('hidden');
      }, 1500);
    }
  });
</script>
