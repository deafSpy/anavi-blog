---
const year = new Date().getFullYear();
---

<!-- 
  Simple Black Footer
  Clean, minimal dark theme
-->
<div class="footer-wrapper" id="contact">
  <div class="footer-sticky-container">
    <footer class="footer-content">
      <!-- Book stacks on the right side -->
      <div class="footer-books" aria-hidden="true">
        <img 
          src="/books/verticalstack.png" 
          alt="" 
          class="footer-book footer-book--vertical"
        />
      </div>

      <div class="footer-inner">
        <!-- Bottom section: Socials + Name -->
        <div class="footer-bottom">
          <!-- Contact Links -->
          <div class="footer-links flex flex-wrap gap-4 mb-6">
            <a 
              href="mailto:anavidasguptalis@gmail.com" 
              class="footer-link"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              anavidasguptalis@gmail.com
            </a>
            
            <a 
              href="https://www.linkedin.com/in/anavi-dasgupta-b6749623a" 
              target="_blank"
              rel="noopener noreferrer"
              class="footer-link"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              LinkedIn
            </a>
          </div>

          <!-- Large artistic name at bottom -->
          <div class="footer-title-wrapper">
            <h2 class="footer-title">Anavi Dasgupta</h2>
          </div>
        </div>
      </div>
    </footer>
  </div>
</div>

<style>
  /* ============================================
     SIMPLE BLACK FOOTER
     ============================================ */
  .footer-wrapper {
    position: relative;
    height: 500px; /* Smaller footer */
    clip-path: polygon(0% 0, 100% 0%, 100% 100%, 0 100%);
  }

  .footer-sticky-container {
    position: relative;
    height: calc(100vh + 500px);
    top: -100vh;
  }

  .footer-content {
    position: sticky;
    top: calc(100vh - 500px);
    height: 500px;
    overflow: hidden;
    /* Clean black background */
    background: #0a0a0a;
    color: white;
  }

  .footer-inner {
    position: relative;
    height: 100%;
    max-width: 80rem;
    margin: 0 auto;
    padding: 2rem 2rem 0 2rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end; /* Push everything to bottom */
    z-index: 2; /* Above books */
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* ============================================
     BOOK STACKS
     ============================================ */
  .footer-books {
    position: absolute;
    right: 2rem;
    bottom: 0;
    top: 0;
    width: 500px;
    pointer-events: none;
    z-index: 1;
  }

  .footer-book {
    position: absolute;
    opacity: 1;
  }

  .footer-book--horizontal {
    width: clamp(100px, 15vw, 160px);
    right: 0;
    bottom: 20%;
    transform: rotate(-5deg);
  }

  .footer-book--vertical {
    width: clamp(80px, 12vw, 140px);
    right: 10%;
    top: 15%;
    transform: scaleX(-1) rotate(5deg); /* Flipped horizontally */
  }

  /* ============================================
     TITLE STYLING
     ============================================ */
  .footer-title-wrapper {
    position: relative;
    display: block;
    width: 100%;
    margin-bottom: 0; /* Touch the bottom */
    padding-bottom: 0;
  }

  .footer-title {
    font-size: clamp(4rem, 15vw, 12rem); /* Larger font size */
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 0.9; /* Tighter line height */
    margin-bottom: 0.0em; /* Pull down to touch bottom edge */
    padding-bottom: 0.2em;
    /* Subtle gradient text */
    background: linear-gradient(
      135deg, 
      #ffffff 0%, 
      #e5e5e5 50%,
      #ffffff 100%
    );
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: shimmer 6s ease-in-out infinite;
  }

  @supports not (-webkit-background-clip: text) {
    .footer-title {
      color: #ffffff;
      background: none;
      -webkit-text-fill-color: unset;
    }
  }

  @keyframes shimmer {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  /* ============================================
     CONTACT LINKS - Clean style
     ============================================ */
  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.875rem 1.5rem;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    color: #a3a3a3;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .footer-link:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
    color: #ffffff;
    transform: translateY(-3px);
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5);
  }

  /* ============================================
     MOBILE
     ============================================ */
  @media (max-width: 768px) {
    .footer-wrapper {
      height: 400px;
    }

    .footer-sticky-container {
      height: calc(100vh + 400px);
    }

    .footer-content {
      top: calc(100vh - 400px);
      height: 400px;
    }

    .footer-title {
      font-size: clamp(2.5rem, 12vw, 6rem);
    }

    .footer-books {
      display: none; /* Hide on mobile */
    }
  }
</style>
