---
// JourneyStrip - Awwwards-style horizontal scroll section
// Features: Unified design, smooth animations, glassmorphism cards
---

<section 
  class="journey-wrapper relative w-full overflow-hidden"
  aria-labelledby="journey-title"
>
  <!-- Full-width horizontal section -->
  <div
    class="journey-section relative w-full lg:min-h-screen"
    data-horizontal-scroll
  >
    <!-- Background gradient -->
    <div class="absolute inset-0 journey-bg" aria-hidden="true"></div>
    
    <!-- Animated lines background -->
    <div class="journey-lines" aria-hidden="true">
      <div class="journey-line journey-line-1"></div>
      <div class="journey-line journey-line-2"></div>
      <div class="journey-line journey-line-3"></div>
    </div>

    <div
      class="relative flex flex-col lg:flex-row lg:items-center lg:h-screen"
      data-horizontal-wrapper
    >
      <!-- Header Card - First in scroll -->
      <article class="journey-card journey-card-header flex-shrink-0 lg:w-[60vw] lg:h-full flex items-center justify-center p-8 lg:p-16">
        <div class="max-w-xl space-y-6">
          <p 
            class="text-sm font-medium uppercase tracking-[0.4em] text-stone-500"
            data-flip-reveal
          >
            About
          </p>
          <h2 
            id="journey-title" 
            class="text-5xl lg:text-7xl font-bold text-stone-900 leading-[0.95]"
            data-flip-reveal
            data-flip-stagger="0.03"
          >
            A living<br/>timeline
          </h2>
          <p class="text-lg text-stone-600 leading-relaxed" data-reveal="up">
            Scroll through my journey—a collection of moments, milestones, and the spaces in between.
          </p>
          <div class="flex items-center gap-3 text-stone-400" data-reveal="up">
            <span class="w-12 h-px bg-stone-300"></span>
            <span class="text-sm">Scroll to explore</span>
            <svg class="w-4 h-4 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </div>
        </div>
      </article>

      <!-- Moment 1: Roots -->
      <article class="journey-card flex-shrink-0 lg:w-[70vw] lg:h-full flex items-center p-8 lg:p-12">
        <div class="journey-moment">
          <div class="journey-moment-content">
            <span class="journey-badge journey-badge-orange">Roots</span>
            <h3 class="journey-moment-title">
              Learning to document what matters
            </h3>
            <p class="journey-moment-text">
              Early field notes: constraints, community, and the discipline of shipping with low bandwidth in mind.
            </p>
          </div>
          
          <div class="journey-moment-visual">
            <!-- Stacked cards with glassmorphism -->
            <div class="journey-stack">
              <div 
                class="journey-photo journey-photo-1"
                data-parallax="-0.06"
                data-depth="1.5"
              >
                <div class="journey-photo-inner">
                  <div class="journey-photo-gradient gradient-warm"></div>
                </div>
                <span class="journey-photo-label">Photo</span>
              </div>
              
              <div 
                class="journey-photo journey-photo-2"
                data-parallax="0.08"
                data-depth="2"
              >
                <div class="journey-photo-inner">
                  <div class="journey-photo-gradient gradient-cool"></div>
                </div>
                <span class="journey-photo-label">Portrait</span>
              </div>
              
              <div 
                class="journey-quote journey-quote-dark"
                data-parallax="0.03"
              >
                "A small note becomes a map for someone else."
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- Moment 2: Systems -->
      <article class="journey-card flex-shrink-0 lg:w-[70vw] lg:h-full flex items-center p-8 lg:p-12">
        <div class="journey-moment journey-moment-reverse">
          <div class="journey-moment-visual lg:order-1">
            <div class="journey-stack">
              <div 
                class="journey-photo journey-photo-3"
                data-parallax="-0.08"
                data-depth="1.8"
              >
                <div class="journey-photo-inner">
                  <div class="journey-photo-gradient gradient-subtle"></div>
                </div>
                <span class="journey-photo-label">System</span>
              </div>
              
              <div 
                class="journey-photo journey-photo-4"
                data-parallax="0.06"
                data-depth="1.3"
              >
                <div class="journey-photo-inner">
                  <div class="journey-photo-gradient gradient-mixed"></div>
                </div>
                <span class="journey-photo-label">Field</span>
              </div>
              
              <div 
                class="journey-quote journey-quote-light"
                data-parallax="-0.04"
              >
                <span class="text-orange-500 font-semibold">Milestone:</span> repeatable blocks for stories and timelines.
              </div>
            </div>
          </div>
          
          <div class="journey-moment-content lg:order-2">
            <span class="journey-badge journey-badge-blue">Systems</span>
            <h3 class="journey-moment-title">
              Making structure feel human
            </h3>
            <p class="journey-moment-text">
              A site that behaves like a field notebook—alive, tactile, and built for imperfect connections.
            </p>
          </div>
        </div>
      </article>

      <!-- Moment 3: Next -->
      <article class="journey-card flex-shrink-0 lg:w-[70vw] lg:h-full flex items-center p-8 lg:p-12">
        <div class="journey-moment">
          <div class="journey-moment-content">
            <span class="journey-badge journey-badge-green">Next</span>
            <h3 class="journey-moment-title">
              Depth without heaviness
            </h3>
            <p class="journey-moment-text">
              Lightweight motion, composited collages, and story-first visuals—kept accessible and cache-friendly.
            </p>
          </div>
          
          <div class="journey-moment-visual">
            <div class="journey-stack">
              <div 
                class="journey-photo journey-photo-5"
                data-parallax="-0.1"
                data-depth="1.6"
              >
                <div class="journey-photo-inner">
                  <div class="journey-photo-gradient gradient-warm-green"></div>
                </div>
                <span class="journey-photo-label">Prototype</span>
              </div>
              
              <div 
                class="journey-photo journey-photo-6"
                data-parallax="0.07"
                data-depth="2"
              >
                <div class="journey-photo-inner">
                  <div class="journey-photo-gradient gradient-neutral"></div>
                </div>
                <span class="journey-photo-label">Sketch</span>
              </div>
              
              <div 
                class="journey-quote journey-quote-accent"
                data-parallax="0.04"
              >
                Keep it fast, keep it readable, keep it real.
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- End spacer -->
      <div class="hidden flex-shrink-0 lg:block lg:w-32" aria-hidden="true"></div>
    </div>
  </div>
</section>

<style>
  .journey-wrapper {
    margin-top: 4rem;
  }

  .journey-section {
    background: linear-gradient(135deg, #fafaf9 0%, #f5f5f4 50%, #e7e5e4 100%);
  }

  .journey-bg {
    background: 
      radial-gradient(ellipse 80% 50% at 20% 40%, rgba(249, 115, 22, 0.05), transparent),
      radial-gradient(ellipse 60% 40% at 80% 60%, rgba(14, 165, 233, 0.04), transparent);
  }

  /* Animated background lines */
  .journey-lines {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .journey-line {
    position: absolute;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(0,0,0,0.04), transparent);
    animation: lineSweep 20s linear infinite;
  }

  .journey-line-1 { top: 25%; width: 60%; animation-delay: 0s; }
  .journey-line-2 { top: 50%; width: 80%; animation-delay: 7s; }
  .journey-line-3 { top: 75%; width: 50%; animation-delay: 14s; }

  @keyframes lineSweep {
    0% { left: -60%; opacity: 0; }
    10% { opacity: 1; }
    90% { opacity: 1; }
    100% { left: 100%; opacity: 0; }
  }

  /* Journey cards */
  .journey-card {
    position: relative;
  }

  .journey-card-header {
    background: transparent;
  }

  /* Moment layout */
  .journey-moment {
    display: grid;
    gap: 3rem;
    width: 100%;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .journey-moment {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }

  .journey-moment-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .journey-badge {
    display: inline-flex;
    align-self: flex-start;
    padding: 0.375rem 0.875rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .journey-badge-orange {
    background: rgba(249, 115, 22, 0.1);
    color: #ea580c;
  }

  .journey-badge-blue {
    background: rgba(14, 165, 233, 0.1);
    color: #0284c7;
  }

  .journey-badge-green {
    background: rgba(16, 185, 129, 0.1);
    color: #059669;
  }

  .journey-moment-title {
    font-size: 2rem;
    font-weight: 700;
    color: #1c1917;
    line-height: 1.2;
  }

  @media (min-width: 1024px) {
    .journey-moment-title {
      font-size: 2.5rem;
    }
  }

  .journey-moment-text {
    font-size: 1.125rem;
    line-height: 1.7;
    color: #57534e;
  }

  /* Visual stack */
  .journey-moment-visual {
    position: relative;
    min-height: 20rem;
  }

  @media (min-width: 1024px) {
    .journey-moment-visual {
      min-height: 28rem;
    }
  }

  .journey-stack {
    position: relative;
    width: 100%;
    height: 100%;
  }

  /* Photo cards */
  .journey-photo {
    position: absolute;
    background: white;
    border-radius: 1rem;
    box-shadow: 
      0 4px 6px -1px rgba(0, 0, 0, 0.05),
      0 20px 40px -15px rgba(0, 0, 0, 0.1);
    border: 1px solid rgba(0, 0, 0, 0.04);
    overflow: hidden;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.5s ease;
  }

  .journey-photo:hover {
    transform: scale(1.02) !important;
    box-shadow: 
      0 8px 12px -2px rgba(0, 0, 0, 0.08),
      0 30px 60px -20px rgba(0, 0, 0, 0.15);
  }

  .journey-photo-inner {
    position: absolute;
    inset: 0;
  }

  .journey-photo-gradient {
    width: 100%;
    height: 100%;
  }

  .gradient-warm {
    background: linear-gradient(135deg, #fed7aa 0%, #fef3c7 50%, #ffffff 100%);
  }

  .gradient-cool {
    background: linear-gradient(135deg, #bae6fd 0%, #ffffff 50%, #fef3c7 100%);
  }

  .gradient-subtle {
    background: linear-gradient(135deg, #fef3c7 0%, #ffffff 50%, #f5f5f4 100%);
  }

  .gradient-mixed {
    background: linear-gradient(135deg, #e0f2fe 0%, #ffffff 50%, #fed7aa 100%);
  }

  .gradient-warm-green {
    background: linear-gradient(135deg, #fed7aa 0%, #ffffff 50%, #d1fae5 100%);
  }

  .gradient-neutral {
    background: linear-gradient(135deg, #f5f5f4 0%, #ffffff 50%, #e0f2fe 100%);
  }

  .journey-photo-label {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #78716c;
  }

  /* Photo positioning */
  .journey-photo-1 {
    width: 16rem;
    height: 12rem;
    left: 0;
    top: 2rem;
    transform: rotate(-4deg);
  }

  .journey-photo-2 {
    width: 12rem;
    height: 16rem;
    right: 0;
    top: 4rem;
    transform: rotate(6deg);
  }

  .journey-photo-3 {
    width: 18rem;
    height: 13rem;
    left: 0;
    top: 1rem;
    transform: rotate(3deg);
  }

  .journey-photo-4 {
    width: 13rem;
    height: 13rem;
    right: 1rem;
    top: 0;
    transform: rotate(-7deg);
  }

  .journey-photo-5 {
    width: 15rem;
    height: 14rem;
    left: 1rem;
    top: 1rem;
    transform: rotate(-3deg);
  }

  .journey-photo-6 {
    width: 14rem;
    height: 16rem;
    right: 0;
    top: 3rem;
    transform: rotate(8deg);
  }

  /* Quote cards */
  .journey-quote {
    position: absolute;
    max-width: 16rem;
    padding: 1.25rem;
    border-radius: 0.75rem;
    font-size: 0.9rem;
    line-height: 1.5;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.15);
  }

  .journey-quote-dark {
    bottom: 2rem;
    left: 1rem;
    background: #1c1917;
    color: white;
    transform: rotate(-1deg);
  }

  .journey-quote-light {
    bottom: 2rem;
    right: 0;
    background: white;
    color: #44403c;
    border: 1px solid rgba(0, 0, 0, 0.06);
    backdrop-filter: blur(10px);
    transform: rotate(1deg);
  }

  .journey-quote-accent {
    bottom: 2rem;
    left: 0;
    background: linear-gradient(135deg, #f97316, #fb923c);
    color: white;
    font-weight: 500;
    transform: rotate(-1deg);
  }

  /* Mobile adjustments */
  @media (max-width: 1023px) {
    .journey-photo-1 { width: 12rem; height: 9rem; }
    .journey-photo-2 { width: 9rem; height: 12rem; }
    .journey-photo-3 { width: 14rem; height: 10rem; }
    .journey-photo-4 { width: 10rem; height: 10rem; }
    .journey-photo-5 { width: 11rem; height: 10rem; }
    .journey-photo-6 { width: 10rem; height: 12rem; }
    
    .journey-quote { max-width: 12rem; font-size: 0.8rem; }
  }
</style>
