---
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchAllPosts } from '../lib/google-docs';

const posts = await fetchAllPosts();

// Hero name split into two lines
const firstName = "ANAVI";
const lastName = "DASGUPTA";
---

<BaseLayout title="Anavi Dasgupta" description="Purpose-led portfolio and field journal">
  <!-- ============================================
       ALA-STYLE LOADING OVERLAY (Skip for now per user request)
       ============================================ -->
  <div id="ala-loader" class="ala-loader" style="display: none;">
    <!-- Loader content preserved but hidden -->
  </div>

  <!-- ============================================
       ORIGINAL LOADING OVERLAY (COMMENTED OUT)
       Preserved for potential future use
       ============================================ -->
  <!--
  <div id="loading-overlay" class="loading-overlay">
    <div class="loading-content">
      <div class="loading-logo">
        {'ANAVI'.split('').map((char, i) => (
          <span style={`--char-index: ${i}`}>{char}</span>
        ))}
      </div>
      <div class="loading-bar">
        <div class="loading-bar-fill"></div>
      </div>
    </div>
  </div>
  -->

  <!-- ============================================
       NAVBAR - Clean, Always Visible
       ============================================ -->
  <nav class="site-nav" data-navbar>
    <a href="/" class="site-nav__brand" data-nav-brand>
      ANAVI DASGUPTA
    </a>
    
    <div class="site-nav__links" data-nav-links>
      <a href="#work" class="site-nav__link" data-nav-link="work">
        WORK
        <span class="site-nav__underline"></span>
      </a>
      <span class="site-nav__comma">,</span>
      <a href="#blog" class="site-nav__link" data-nav-link="blog">
        BLOG
        <span class="site-nav__underline"></span>
      </a>
      <span class="site-nav__comma">,</span>
      <a href="#contact" class="site-nav__link" data-nav-link="contact">
        CONTACT
        <span class="site-nav__underline"></span>
      </a>
    </div>
  </nav>

  <!-- ============================================
       HERO SECTION - Text at Bottom, Centered
       ============================================ -->
  <section class="hero" id="work">
    <!-- Central Portrait -->
    <div class="hero__portrait" data-hero-portrait>
      <div class="hero__portrait-inner">
        <img src="/anavijaipur.png" alt="Anavi Dasgupta" class="hero__portrait-img" />
      </div>
    </div>

    <!-- Hero Text at Bottom - Two Lines -->
    <div class="hero__text-container">
      <h1 class="hero__title" data-hero-text>
        <span class="hero__line" data-hero-line>{firstName}</span>
        <span class="hero__line" data-hero-line>{lastName}</span>
      </h1>
    </div>

    <!-- Blue glow border effect -->
    <div class="hero__glow" aria-hidden="true"></div>
  </section>

  <!-- ============================================
       BOOKS SIMULATION SECTION (Matter.js)
       ============================================ -->
  <section class="books-section" id="books-simulation">
    <canvas id="books-canvas"></canvas>
  </section>

  <!-- ============================================
       BLOG ROLL SECTION
       ============================================ -->
  <section class="blog-section" id="blog">
    <div class="mx-auto max-w-6xl px-6 md:px-8">
      <div class="grid gap-12 lg:grid-cols-[0.4fr_1fr] lg:items-start">
        <div class="space-y-4 lg:sticky lg:top-32" data-blog-header>
          <p class="text-sm font-medium uppercase tracking-[0.3em] text-stone-500" data-blog-line>Latest</p>
          <h2 class="text-4xl font-bold text-stone-900" data-blog-line>Blog roll</h2>
          <p class="text-stone-600" data-blog-line>Field notes, experiments, and reflections.</p>
        </div>

        <div class="space-y-4" data-stagger>
          {posts.map((post) => (
            <a
              class="blog-card group flex items-start gap-6 p-6 border border-stone-200/60"
              href={`/posts/${post.slug}`}
              data-stagger-item
            >
              <div class="flex-1 space-y-2">
                <div class="flex items-center gap-2 text-xs font-medium uppercase tracking-[0.25em] text-stone-500">
                  <span>{post.metadata?.category ?? 'Notes'}</span>
                </div>
                <h3 class="text-xl font-semibold text-stone-900 group-hover:text-orange-600 transition-colors">
                  {post.title}
                </h3>
                <p class="text-sm text-stone-600 line-clamp-2">{post.description}</p>
              </div>
              <div class="text-right text-sm text-stone-500 shrink-0">
                <p class="font-medium">
                  {new Date(post.publishedAt).toLocaleDateString(undefined, { month: 'short', day: 'numeric' })}
                </p>
                <p class="mt-2 text-orange-500 opacity-0 group-hover:opacity-100 transition-opacity">→</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================
       GSAP ANIMATIONS SCRIPT
       ============================================ -->
  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    function initAnimations() {
      const navBrand = document.querySelector('[data-nav-brand]');
      const navLinks = document.querySelectorAll('[data-nav-links] .site-nav__link');
      const heroLines = document.querySelectorAll('[data-hero-line]');
      const heroPortrait = document.querySelector('[data-hero-portrait]');
      const heroGlow = document.querySelector('.hero__glow');

      // Create master timeline
      const tl = gsap.timeline({ delay: 0.3 });

      // Navbar brand fade in
      tl.fromTo(navBrand,
        { opacity: 0, y: -20 },
        { opacity: 1, y: 0, duration: 0.8, ease: "power3.out" },
        0
      );

      // Nav links stagger in
      tl.fromTo(navLinks,
        { opacity: 0, x: 20 },
        { opacity: 1, x: 0, duration: 0.6, stagger: 0.1, ease: "power2.out" },
        0.2
      );

      // Hero portrait reveal
      tl.fromTo(heroPortrait,
        { 
          clipPath: "inset(100% 0% 0% 0%)",
          scale: 1.05
        },
        { 
          clipPath: "inset(0% 0% 0% 0%)",
          scale: 1,
          duration: 1.2,
          ease: "power3.out"
        },
        0.4
      );

      // Hero text lines stagger
      tl.fromTo(heroLines,
        { 
          opacity: 0,
          y: 80
        },
        { 
          opacity: 1,
          y: 0,
          duration: 0.8,
          stagger: 0.15,
          ease: "power3.out"
        },
        0.6
      );

      // Glow border fade in
      tl.fromTo(heroGlow,
        { opacity: 0 },
        { opacity: 1, duration: 1, ease: "power2.out" },
        0.8
      );
    }

    // Initialize section-based navbar underline tracking
    function initSectionTracking() {
      const sections = ['work', 'blog', 'contact'];
      
      sections.forEach(sectionId => {
        const section = document.getElementById(sectionId);
        const navLink = document.querySelector(`[data-nav-link="${sectionId}"]`);
        const underline = navLink?.querySelector('.site-nav__underline');
        
        if (!section || !navLink || !underline) return;
        
        ScrollTrigger.create({
          trigger: section,
          start: 'top center',
          end: 'bottom center',
          onEnter: () => {
            gsap.to(underline, { scaleX: 1, duration: 0.3, ease: 'power2.out' });
          },
          onLeave: () => {
            gsap.to(underline, { scaleX: 0, duration: 0.3, ease: 'power2.in' });
          },
          onEnterBack: () => {
            gsap.to(underline, { scaleX: 1, duration: 0.3, ease: 'power2.out' });
          },
          onLeaveBack: () => {
            gsap.to(underline, { scaleX: 0, duration: 0.3, ease: 'power2.in' });
          }
        });
      });
    }

    // Initialize scroll effects
    import('../components/ScrollOrchestrator').then(({ init }) => {
      setTimeout(init, 100);
    }).catch(() => {});

    // Run animations
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        initAnimations();
        setTimeout(initSectionTracking, 500);
        initBooksSimulation();
      });
    } else {
      initAnimations();
      setTimeout(initSectionTracking, 500);
      initBooksSimulation();
    }

    // Matter.js Book Simulation
    async function initBooksSimulation() {
      const Matter = await import('matter-js');
      const { Engine, Render, Runner, Bodies, Composite, Body, Events } = Matter;
      
      const canvas = document.getElementById('books-canvas') as HTMLCanvasElement;
      if (!canvas) return;
      
      const section = document.getElementById('books-simulation');
      if (!section) return;

      // Set canvas size
      const width = section.offsetWidth;
      const height = 300;
      canvas.width = width;
      canvas.height = height;

      // Create engine
      const engine = Engine.create({
        gravity: { x: 0.15, y: 1 } // Slight rightward gravity for toppling effect
      });

      // Create renderer
      const render = Render.create({
        canvas: canvas,
        engine: engine,
        options: {
          width: width,
          height: height,
          wireframes: false,
          background: '#fafafa'
        }
      });

      // Ground
      const ground = Bodies.rectangle(width / 2, height + 25, width + 100, 50, {
        isStatic: true,
        render: { fillStyle: '#fafafa' }
      });

      // Right wall (invisible pusher)
      const rightWall = Bodies.rectangle(width + 50, height / 2, 100, height, {
        isStatic: true,
        render: { fillStyle: 'transparent' }
      });

      // Create books with varying sizes - tightly packed
      const books: typeof Bodies.rectangle[] = [];
      const numBooks = 25; // More books for tighter packing
      
      for (let i = 0; i < numBooks; i++) {
        // Randomly decide if showing spine (thin) or pages (slightly thicker)
        const isSpine = Math.random() > 0.4; // More spines
        
        // Book dimensions - narrower overall
        const bookHeight = 50 + Math.random() * 45; // 50-95px
        const bookWidth = isSpine ? (6 + Math.random() * 8) : (12 + Math.random() * 13); // Spine: 6-14px, Pages: 12-25px
        
        // Color based on type
        const spineColors = ['#1a1a1a', '#2d2d2d', '#8b4513', '#654321', '#3d3d3d', '#4a3728'];
        const pageColors = ['#f5f5dc', '#faf0e6', '#fffdf7', '#fefefa', '#f8f4e3'];
        const color = isSpine 
          ? spineColors[Math.floor(Math.random() * spineColors.length)]
          : pageColors[Math.floor(Math.random() * pageColors.length)];
        
        // Position books more tightly - clustered in left/center
        const x = 30 + (i * (width - 60) / numBooks) + Math.random() * 15;
        const y = -50 - Math.random() * 150; // Start above canvas
        
        const book = Bodies.rectangle(x, y, bookWidth, bookHeight, {
          friction: 0.95, // High friction
          frictionStatic: 0.9,
          frictionAir: 0.01,
          restitution: 0.05, // Less bouncy
          density: 0.002,
          angle: -0.15 + Math.random() * 0.3, // Slight random rotation
          render: {
            fillStyle: color,
            strokeStyle: isSpine ? 'transparent' : '#ddd',
            lineWidth: isSpine ? 0 : 1
          }
        });
        
        books.push(book);
      }

      // Add all bodies
      Composite.add(engine.world, [ground, rightWall, ...books]);

      // Run simulation
      Render.run(render);
      const runner = Runner.create();
      Runner.run(runner, engine);

      // Apply initial rightward impulse after a delay
      setTimeout(() => {
        books.forEach((book, i) => {
          setTimeout(() => {
            Body.applyForce(book, book.position, { x: 0.003 + Math.random() * 0.002, y: 0 });
          }, i * 100);
        });
      }, 500);

      // Handle resize
      window.addEventListener('resize', () => {
        const newWidth = section.offsetWidth;
        canvas.width = newWidth;
        render.options.width = newWidth;
        Render.setPixelRatio(render, window.devicePixelRatio);
      });
    }
  </script>
</BaseLayout>

<style>
  /* ============================================
     NAVBAR - Clean, Always Visible
     ============================================ */
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    padding: 1.5rem 2.5rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    background: transparent;
    mix-blend-mode: difference;
  }

  .site-nav__brand {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    color: white;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .site-nav__brand:hover {
    opacity: 0.6;
  }

  .site-nav__links {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.25rem;
  }

  .site-nav__comma {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 0.7rem;
    font-weight: 500;
    color: white;
    margin: 0 0.15rem;
  }

  .site-nav__link {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: white;
    text-decoration: none;
    text-transform: uppercase;
    padding: 0.15rem 0;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .site-nav__underline {
    display: block;
    width: 100%;
    height: 1px;
    background: white;
    transform: scaleX(0);
    transform-origin: center;
  }

  .site-nav__link:hover .site-nav__underline {
    transform: scaleX(1);
  }

  .site-nav__link.active .site-nav__underline {
    transform: scaleX(1);
  }

  /* ============================================
     HERO SECTION
     ============================================ */
  .hero {
    position: relative;
    min-height: 100vh;
    width: 100%;
    background: #fafafa;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding: 2rem;
    padding-bottom: 3rem;
    overflow: visible;
  }

  /* Blue glow border */
  .hero__glow {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 50;
    border: 4px solid rgba(59, 130, 246, 0.5);
    box-shadow: 
      inset 0 0 80px rgba(59, 130, 246, 0.1),
      inset 0 0 200px rgba(59, 130, 246, 0.05);
  }

  /* Portrait */
  .hero__portrait {
    position: absolute;
    top: 40%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: clamp(200px, 25vw, 300px);
    aspect-ratio: 3/4;
    z-index: 2;
    overflow: hidden;
    box-shadow: 0 25px 80px rgba(0, 0, 0, 0.15);
    border: 1px solid rgba(0, 0, 0, 0.08);
  }

  .hero__portrait-inner {
    width: 100%;
    height: 100%;
  }

  .hero__portrait-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  /* Text Container - Positioned at bottom, centered */
  .hero__text-container {
    position: relative;
    z-index: 1;
    width: 100%;
    text-align: center;
    padding: 0 1rem;
  }

  .hero__title {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: clamp(3.5rem, 14vw, 12rem);
    font-weight: 900;
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: #0a0a0a;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero__line {
    display: flex;
    justify-content: center;
  }

  .hero__char {
    display: block;
    will-change: transform, opacity;
  }

  /* ============================================
     BOOKS SIMULATION SECTION
     ============================================ */
  .books-section {
    width: 100%;
    height: 300px;
    background: #fafafa;
    overflow: hidden;
    position: relative;
  }

  #books-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* ============================================
     BLOG SECTION
     ============================================ */
  .blog-section {
    padding: 6rem 0;
    background: #fafafa;
  }

  /* ============================================
     LOADER (Hidden for now)
     ============================================ */
  .ala-loader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #0a0a0a;
    display: none;
  }

  /* ============================================
     MOBILE RESPONSIVE
     ============================================ */
  @media (max-width: 768px) {
    .site-nav {
      padding: 1.25rem 1.5rem;
    }

    .site-nav__brand {
      font-size: 0.65rem;
    }

    .site-nav__link {
      font-size: 0.55rem;
    }

    .site-nav__comma {
      font-size: 0.55rem;
      margin: 0 0.1rem;
    }

    .hero {
      padding: 1.5rem;
      padding-bottom: 2rem;
    }

    .hero__portrait {
      top: 35%;
      width: 45vw;
      max-width: 180px;
    }

    .hero__title {
      font-size: clamp(2.5rem, 15vw, 5rem);
    }

    .books-section {
      height: 200px;
    }
  }

  @media (max-width: 480px) {
    .site-nav__links {
      gap: 0.15rem;
    }

    .site-nav__link {
      font-size: 0.5rem;
      letter-spacing: 0.08em;
    }

    .hero__portrait {
      top: 32%;
      width: 50vw;
      max-width: 160px;
    }

    .hero__title {
      font-size: clamp(2rem, 16vw, 4rem);
      letter-spacing: -0.02em;
    }

    .books-section {
      height: 150px;
    }
  }
</style>
