import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Anavi Blog" description="Stories from the Barefoot College fellowship">
  <section class="mx-auto flex min-h-screen max-w-5xl flex-col gap-16 px-6 py-16">
    <header class="space-y-4">
      <p class="text-sm uppercase tracking-[0.3em] text-slate-400">Barefoot College Fellowship</p>
      <h1 class="text-4xl font-semibold leading-tight text-slate-100 sm:text-5xl">
        Stories, field notes, and learnings from a 12-month journey.
      </h1>
      <p class="max-w-2xl text-lg text-slate-300">
        Follow the project as it unfolds—solar empowerment, community-first design, and the people
        at the heart of Barefoot College.
      </p>
    </header>

    <div class="grid gap-8 md:grid-cols-2">
      <article class="rounded-2xl border border-slate-800 bg-surface-800/60 p-6 shadow-lg shadow-black/30">
        <p class="text-xs uppercase tracking-[0.2em] text-slate-400">Featured</p>
        <h2 class="mt-3 text-2xl font-semibold text-slate-100">Launch journal</h2>
        <p class="mt-2 text-slate-300">
          A living log capturing weekly milestones, learnings, and setbacks.
        </p>
        <a class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-accent-400" href="/posts">
          Read the journal →
        </a>
      </article>
      <article class="rounded-2xl border border-slate-800 bg-surface-800/60 p-6 shadow-lg shadow-black/30">
        <p class="text-xs uppercase tracking-[0.2em] text-slate-400">Gallery</p>
        <h2 class="mt-3 text-2xl font-semibold text-slate-100">People and places</h2>
        <p class="mt-2 text-slate-300">
          Visual snippets from the field—installations, workshops, and community moments.
        </p>
        <a class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-accent-400" href="/posts">
          View updates →
        </a>
      </article>
    </div>
  </section>
</BaseLayout>
