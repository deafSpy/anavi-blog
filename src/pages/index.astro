---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookLoader from '../components/BookLoader.astro';
import { fetchAllPosts } from '../lib/google-docs';

const posts = await fetchAllPosts();

// Hero name split into two lines
const firstName = "ANAVI";
const lastName = "DASGUPTA";
---

<BaseLayout title="Anavi Dasgupta" description="Purpose-led portfolio and field journal">
  <!-- ============================================
       BOOK FLIP LOADING ANIMATION
       ============================================ -->
  <BookLoader />
  
  <!-- WebGL Reveal Container -->
  <div id="webgl-reveal-container" aria-hidden="true"></div>

  <!-- ============================================
       ORIGINAL LOADING OVERLAY (COMMENTED OUT)
       Preserved for potential future use
       ============================================ -->
  <!--
  <div id="loading-overlay" class="loading-overlay">
    <div class="loading-content">
      <div class="loading-logo">
        {'ANAVI'.split('').map((char, i) => (
          <span style={`--char-index: ${i}`}>{char}</span>
        ))}
      </div>
      <div class="loading-bar">
        <div class="loading-bar-fill"></div>
      </div>
    </div>
  </div>
  -->

  <!-- ============================================
       NAVBAR - Clean, Always Visible
       ============================================ -->
  <nav class="site-nav" data-navbar>
    <a href="/" class="site-nav__brand" data-nav-brand>
      ANAVI DASGUPTA
    </a>
    
    <div class="site-nav__links" data-nav-links>
      <a href="#work" class="site-nav__link" data-nav-link="work">
        WORK
        <span class="site-nav__underline"></span>
      </a>
      <span class="site-nav__comma">,</span>
      <a href="#blog" class="site-nav__link" data-nav-link="blog">
        BLOG
        <span class="site-nav__underline"></span>
      </a>
      <span class="site-nav__comma">,</span>
      <a href="#contact" class="site-nav__link" data-nav-link="contact">
        CONTACT
        <span class="site-nav__underline"></span>
      </a>
    </div>
  </nav>

  <!-- ============================================
       HERO SECTION - Text at Bottom, Centered
       ============================================ -->
  <section class="hero" id="work">
    <!-- Background Image with Blur/Darkening Overlay - EXTENDS INTO BLOG SECTION -->
    <div class="hero__background" aria-hidden="true">
      <img src="/books/background.png" alt="" class="hero__background-img" />
      <div class="hero__background-overlay"></div>
    </div>

    <!-- Decorative SVG Animations -->
    <div class="hero__decorations" aria-hidden="true">
      <svg class="hero__deco hero__deco--circle-1" viewBox="0 0 100 100">
        <circle cx="50" cy="50" r="45" fill="none" stroke="currentColor" stroke-width="1" opacity="0.3"/>
      </svg>
      <svg class="hero__deco hero__deco--circle-2" viewBox="0 0 100 100">
        <circle cx="50" cy="50" r="30" fill="none" stroke="currentColor" stroke-width="1" opacity="0.2"/>
      </svg>
      <!-- Arrow pointing DOWN -->
      <svg class="hero__deco hero__deco--arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M12 5v14M12 19l-5-5M12 19l5-5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>

    <!-- Central Portrait -->
    <div class="hero__portrait" data-hero-portrait>
      <div class="hero__portrait-inner">
        <img src="/anavi_read.jpg" alt="Anavi Dasgupta" class="hero__portrait-img" />
      </div>
    </div>

    <!-- Hero Text at Bottom - Two Lines -->
    <div class="hero__text-container">
      <h1 class="hero__title" data-hero-text>
        <span class="hero__line" data-hero-line>{firstName}</span>
        <span class="hero__line" data-hero-line>{lastName}</span>
      </h1>
    </div>
  </section>

  <!-- ============================================
       BLOG ROLL SECTION - Long Bar Style
       ============================================ -->
  <section class="blog-section" id="blog">
    <!-- Interactive Book Stacks - Moved to Blog Section -->
    <div class="blog-section__books" aria-hidden="true">
      <img 
        src="/books/horizontalstack.png" 
        alt="" 
        class="blog-section__book blog-section__book--horizontal"
        data-book-pop
      />
      <img 
        src="/books/verticalstack.png" 
        alt="" 
        class="blog-section__book blog-section__book--vertical"
        data-book-pop
      />
    </div>

    <div class="blog-section__header">
      <p class="blog-section__label">Latest</p>
      <h2 class="blog-section__title">Blog roll</h2>
    </div>

    <div class="blog-list">
      {posts.map((post) => (
        <a 
          href={`/posts/${post.slug}`}
          class="blog-item"
          data-blog-item
        >
          <div class="blog-item__content">
            <h3 class="blog-item__title">{post.title}</h3>
            <span class="blog-item__date">
              {new Date(post.publishedAt).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' })}
            </span>
          </div>
          <div class="blog-item__arrow">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M7 17L17 7M17 7H7M17 7V17" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ============================================
       GSAP ANIMATIONS SCRIPT
       ============================================ -->
  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    function initAnimations() {
      const navBrand = document.querySelector('[data-nav-brand]');
      const navLinks = document.querySelectorAll('[data-nav-links] .site-nav__link');
      const heroLines = document.querySelectorAll('[data-hero-line]');
      const heroPortrait = document.querySelector('[data-hero-portrait]');

      // Create master timeline
      const tl = gsap.timeline({ delay: 0.3 });

      // Navbar brand fade in
      tl.fromTo(navBrand,
        { opacity: 0, y: -20 },
        { opacity: 1, y: 0, duration: 0.8, ease: "power3.out" },
        0
      );

      // Nav links stagger in
      tl.fromTo(navLinks,
        { opacity: 0, x: 20 },
        { opacity: 1, x: 0, duration: 0.6, stagger: 0.1, ease: "power2.out" },
        0.2
      );

      // Hero portrait reveal
      tl.fromTo(heroPortrait,
        { 
          clipPath: "inset(100% 0% 0% 0%)",
          scale: 1.05
        },
        { 
          clipPath: "inset(0% 0% 0% 0%)",
          scale: 1,
          duration: 1.2,
          ease: "power3.out"
        },
        0.4
      );

      // Hero text lines stagger
      tl.fromTo(heroLines,
        { 
          opacity: 0,
          y: 80
        },
        { 
          opacity: 1,
          y: 0,
          duration: 0.8,
          stagger: 0.15,
          ease: "power3.out"
        },
        0.6
      );
    }

    // Initialize section-based navbar underline tracking
    function initSectionTracking() {
      const sections = ['work', 'blog', 'contact'];
      
      sections.forEach(sectionId => {
        const section = document.getElementById(sectionId);
        const navLink = document.querySelector(`[data-nav-link="${sectionId}"]`);
        const underline = navLink?.querySelector('.site-nav__underline');
        
        if (!section || !navLink || !underline) return;
        
        ScrollTrigger.create({
          trigger: section,
          start: 'top center',
          end: 'bottom center',
          onEnter: () => {
            gsap.to(underline, { scaleX: 1, duration: 0.3, ease: 'power2.out' });
          },
          onLeave: () => {
            gsap.to(underline, { scaleX: 0, duration: 0.3, ease: 'power2.in' });
          },
          onEnterBack: () => {
            gsap.to(underline, { scaleX: 1, duration: 0.3, ease: 'power2.out' });
          },
          onLeaveBack: () => {
            gsap.to(underline, { scaleX: 0, duration: 0.3, ease: 'power2.in' });
          }
        });
      });
    }

    // Initialize scroll effects
    import('../components/ScrollOrchestrator').then(({ init }) => {
      setTimeout(init, 100);
    }).catch(() => {});

    // Initialize smooth scroll for navigation links
    function initSmoothScroll() {
      const navLinks = document.querySelectorAll('.site-nav__link[href^="#"]');
      
      navLinks.forEach(link => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          const targetId = link.getAttribute('href')?.slice(1);
          if (!targetId) return;
          
          const targetSection = document.getElementById(targetId);
          if (targetSection) {
            targetSection.scrollIntoView({ 
              behavior: 'smooth',
              block: 'start'
            });
          }
        });
      });
    }

    // Initialize WebGL reveal transition
    async function initWebGLReveal() {
      try {
        const { initWebGLReveal } = await import('../components/WebGLReveal');
        const container = document.getElementById('webgl-reveal-container');
        if (container) {
          const reveal = initWebGLReveal(container);
          if (reveal) {
            // Start reveal after book loader finishes
            setTimeout(() => reveal.start(), 1600);
          }
        }
      } catch (e) {
        console.warn('WebGL reveal not available:', e);
      }
    }

    // Run animations
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        initAnimations();
        initSmoothScroll();
        initWebGLReveal();
        setTimeout(initSectionTracking, 500);
      });
    } else {
      initAnimations();
      initSmoothScroll();
      initWebGLReveal();
      setTimeout(initSectionTracking, 500);
    }
  </script>
</BaseLayout>

<style>
  /* ============================================
     NAVBAR - Clean, Always Visible
     ============================================ */
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    padding: 1.5rem 2.5rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    background: transparent;
    mix-blend-mode: difference;
    isolation: isolate;
  }

  .site-nav__brand {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    color: white;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .site-nav__brand:hover {
    opacity: 0.6;
  }

  .site-nav__links {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.25rem;
  }

  .site-nav__comma {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 0.7rem;
    font-weight: 500;
    color: white;
    margin: 0 0.15rem;
  }

  .site-nav__link {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: white;
    text-decoration: none;
    text-transform: uppercase;
    padding: 0.15rem 0;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .site-nav__underline {
    display: block;
    width: 100%;
    height: 1px;
    background: white;
    transform: scaleX(0);
    transform-origin: center;
  }

  .site-nav__link:hover .site-nav__underline {
    transform: scaleX(1);
  }

  .site-nav__link.active .site-nav__underline {
    transform: scaleX(1);
  }

  /* ============================================
     HERO SECTION
     ============================================ */
  .hero {
    position: relative;
    min-height: 100vh;
    width: 100%;
    background: transparent; /* No background - image handles it */
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding: 2rem;
    padding-bottom: 3rem;
    overflow: visible; /* Allow background to extend beyond */
  }

  /* Background Image - FULL SIZE, BLEEDS INTO BLOG SECTION */
  .hero__background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    /* Extend to cover hero + blog section (use large value) */
    height: calc(100vh + 600px);
    z-index: 1; /* Low z-index - content goes on top */
    pointer-events: none; /* Allow clicks through */
    overflow: visible;
  }

  .hero__background-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    /* filter: blur(0px); */
    transform: scale(1.02);
  }

  .hero__background-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(250, 250, 250, 0.4) 0%,
      rgba(250, 250, 250, 0.55) 40%,
      rgba(250, 250, 250, 0.75) 70%,
      rgba(245, 245, 240, 0.95) 100%
    );
  }

  /* Book stacks are now in .blog-section__books */

  /* Decorative SVGs */
  .hero__decorations {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    color: #1c1917;
  }

  .hero__deco {
    position: absolute;
    animation: decoFloat 6s ease-in-out infinite;
  }

  .hero__deco--circle-1 {
    width: 80px;
    height: 80px;
    left: 15%;
    top: 25%;
    animation-delay: 0s;
  }

  .hero__deco--circle-2 {
    width: 50px;
    height: 50px;
    right: 20%;
    top: 60%;
    animation-delay: -2s;
  }

  .hero__deco--arrow {
    width: 30px;
    height: 30px;
    left: 25%;
    top: 70%;
    animation-delay: -4s;
    opacity: 0.4;
  }

  @keyframes decoFloat {
    0%, 100% {
      transform: translate(0, 0) rotate(0deg);
      opacity: 0.3;
    }
    33% {
      transform: translate(10px, -15px) rotate(5deg);
      opacity: 0.5;
    }
    66% {
      transform: translate(-5px, 10px) rotate(-3deg);
      opacity: 0.4;
    }
  }

  /* Portrait */
  .hero__portrait {
    position: absolute;
    top: 40%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: clamp(200px, 25vw, 300px);
    aspect-ratio: 3/4;
    z-index: 20;
    overflow: hidden;
    box-shadow: 0 25px 80px rgba(0, 0, 0, 0.15);
    border: 1px solid rgba(0, 0, 0, 0.08);
  }

  .hero__portrait-inner {
    width: 100%;
    height: 100%;
  }

  .hero__portrait-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  /* Text Container - Positioned at bottom, centered */
  .hero__text-container {
    position: relative;
    z-index: 20;
    width: 100%;
    text-align: center;
    padding: 0 1rem;
  }

  .hero__title {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: clamp(3.5rem, 14vw, 12rem);
    font-weight: 900;
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: #0a0a0a;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero__line {
    display: flex;
    justify-content: center;
  }

  .hero__char {
    display: block;
    will-change: transform, opacity;
  }

  /* ============================================
     BLOG SECTION - Long Bar Style
     ============================================ */
  .blog-section {
    position: relative;
    padding: 16rem 2rem 8rem; /* Increased top padding even more */
    margin-top: 8rem; /* More margin for spacing */
    background: transparent; /* Let hero background bleed through */
    z-index: 5; /* Below the hero background */
  }

  /* Book stacks in blog section */
  .blog-section__books {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    pointer-events: none;
  }

  .blog-section__book {
    position: absolute;
    pointer-events: auto;
    cursor: pointer;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), filter 0.3s ease;
    filter: drop-shadow(0 10px 30px rgba(0, 0, 0, 0.15));
  }

  .blog-section__book:hover {
    transform: scale(1.08) translateY(-10px) rotate(-2deg);
    filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.25));
  }

  .blog-section__book--horizontal {
    width: clamp(120px, 18vw, 200px);
    left: 5%;
    top: 30%;
    transform: rotate(-5deg);
  }

  .blog-section__book--horizontal:hover {
    transform: scale(1.08) translateY(-10px) rotate(-7deg);
  }

  .blog-section__book--vertical {
    width: clamp(100px, 15vw, 180px);
    right: 5%;
    top: 15%;
    transform: rotate(8deg);
  }

  .blog-section__book--vertical:hover {
    transform: scale(1.08) translateY(-10px) rotate(6deg);
  }

  .blog-section__header {
    position: relative;
    z-index: 2;
    text-align: center;
    margin-bottom: 3rem;
  }

  .blog-section__label {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #78716c;
    margin-bottom: 0.5rem;
  }

  .blog-section__title {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    color: #1c1917;
    margin: 0;
  }

  .blog-list {
    position: relative;
    z-index: 2;
    max-width: 900px;
    margin: 0 auto;
  }

  .blog-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.75rem 0;
    border-top: 1px solid rgba(0, 0, 0, 0.12);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .blog-item:last-child {
    border-bottom: 1px solid rgba(0, 0, 0, 0.12);
  }

  .blog-item:hover {
    opacity: 0.7;
  }

  .blog-item__content {
    flex: 1;
  }

  .blog-item__title {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: clamp(1.25rem, 3vw, 2rem);
    font-weight: 500;
    color: #1c1917;
    margin: 0 0 0.5rem 0;
    line-height: 1.2;
  }

  .blog-item__date {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 0.8rem;
    color: #78716c;
    letter-spacing: 0.02em;
  }

  .blog-item__arrow {
    width: 48px;
    height: 48px;
    border: 1px solid rgba(0, 0, 0, 0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: 2rem;
    flex-shrink: 0;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .blog-item__arrow svg {
    color: #1c1917;
  }

  .blog-item:hover .blog-item__arrow {
    background: #1c1917;
    border-color: #1c1917;
  }

  .blog-item:hover .blog-item__arrow svg {
    color: #ffffff;
  }

  /* ============================================
     LOADER (Hidden for now)
     ============================================ */
  .ala-loader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #0a0a0a;
    display: none;
  }

  /* ============================================
     MOBILE RESPONSIVE
     ============================================ */
  @media (max-width: 768px) {
    .site-nav {
      padding: 1.25rem 1.5rem;
    }

    .site-nav__brand {
      font-size: 0.65rem;
    }

    .site-nav__link {
      font-size: 0.55rem;
    }

    .site-nav__comma {
      font-size: 0.55rem;
      margin: 0 0.1rem;
    }

    .hero {
      padding: 1.5rem;
      padding-bottom: 1.5rem;
      justify-content: flex-start;
      padding-top: 60vh; /* Text starts at ~3/5 of page */
    }

    .hero__background {
      height: calc(100vh + 400px); /* Full bleed on mobile too */
    }

    .hero__text-container {
      position: relative;
      z-index: 20; /* Above background */
    }

    .hero__portrait {
      top: 25%;
      width: clamp(35vw, 45vw, 180px); /* Dynamic scaling */
      max-width: none;
      z-index: 20; /* Above background */
    }

    .hero__title {
      font-size: clamp(2.5rem, 15vw, 5rem);
    }

    /* Hide book stacks on mobile for cleaner look */
    .blog-section__books {
      display: none;
    }

    /* Adjust decorations for mobile */
    .hero__deco--circle-1 {
      width: 50px;
      height: 50px;
      left: 5%;
      top: 15%;
    }

    .hero__deco--circle-2 {
      width: 35px;
      height: 35px;
      right: 10%;
      top: 50%;
    }

    .hero__deco--arrow {
      display: none;
    }

    .blog-item__arrow {
      width: 40px;
      height: 40px;
      margin-left: 1rem;
    }

    .blog-item__arrow svg {
      width: 20px;
      height: 20px;
    }
  }

  @media (max-width: 480px) {
    .site-nav__links {
      gap: 0.15rem;
    }

    .site-nav__link {
      font-size: 0.5rem;
      letter-spacing: 0.08em;
    }

    .hero {
      justify-content: flex-start;
      padding-top: 55vh; /* Text starts slightly higher on small phones */
      padding-bottom: 1rem;
    }

    .hero__portrait {
      top: 20%;
      width: clamp(40vw, 50vw, 160px); /* Dynamic scaling */
      max-width: none;
    }

    .hero__title {
      font-size: clamp(2rem, 16vw, 4rem);
      letter-spacing: -0.02em;
    }

    .blog-item {
      padding: 1.25rem 0;
    }

    .blog-item__title {
      font-size: 1.1rem;
    }

    .blog-item__arrow {
      width: 36px;
      height: 36px;
    }
  }
</style>
