---
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchPublishedPosts } from '../lib/cmsdocs';
import JourneyStrip from '../components/JourneyStrip.astro';

const posts = await fetchPublishedPosts();
---

<BaseLayout title="Anavi Dasgupta" description="Purpose-led portfolio and field journal">
  <!-- Loading overlay -->
  <div id="loading-overlay"></div>

  <!-- Client islands for scroll effects and 3D head -->
  <script>
    import '../components/ScrollOrchestrator';
    import '../components/HeroHead3D';
  </script>

  <!-- Hero section (contained) -->
  <section class="mx-auto max-w-6xl px-4 py-8 md:px-8 text-slate-900">
    <!-- Navbar -->
    <nav
      class="sticky top-0 z-20 mb-10 flex items-center justify-between rounded-full border border-slate-200 bg-white/85 px-5 py-3 shadow-sm backdrop-blur-md"
      data-reveal="down"
    >
      <div class="flex items-center gap-3">
        <span class="text-lg font-semibold tracking-tight text-slate-900">Anavi</span>
        <span class="hidden text-xs uppercase tracking-[0.35em] text-slate-500 sm:inline">Archive</span>
      </div>
      <div class="flex items-center gap-2 text-sm text-slate-700 sm:gap-4">
        <a class="rounded-full px-3 py-1 transition hover:bg-slate-100" href="/posts">Blog</a>
        <a class="rounded-full px-3 py-1 transition hover:bg-slate-100" href="/about">About</a>
        <a class="rounded-full px-3 py-1 transition hover:bg-slate-100" href="#contact">Contact</a>
      </div>
    </nav>

    <!-- Hero section -->
    <div class="grid gap-10 md:grid-cols-[1.1fr_0.9fr] md:items-center">
      <header class="space-y-4" data-reveal="up">
        <p class="text-sm uppercase tracking-[0.3em] text-slate-500" data-parallax="-0.1">
          Purpose-led portfolio
        </p>
        <h1 class="text-5xl font-semibold leading-tight text-slate-900 sm:text-6xl" data-parallax="0.05">
          Anavi Dasgupta
          <span class="block text-2xl text-accent-600">designs, documents, and delivers</span>
        </h1>
        <p class="max-w-xl text-lg text-slate-600" data-parallax="0.08">
          hi im anavi
        </p>
        <div class="flex flex-wrap gap-3 text-sm text-accent-700" data-reveal="left">
          <span class="rounded-full border border-accent-400/30 bg-accent-50 px-3 py-1">bada</span>
          <span class="rounded-full border border-accent-400/30 bg-accent-50 px-3 py-1">laltu</span>
        </div>
      </header>

      <!-- 3D Head container -->
      <div
        class="relative aspect-square overflow-hidden rounded-3xl border border-slate-200 bg-gradient-to-b from-slate-50 via-white to-slate-100 shadow-2xl shadow-slate-200/70"
        data-reveal="right"
        data-parallax="-0.15"
      >
        <div
          class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(251,146,60,0.25),transparent_40%),radial-gradient(circle_at_80%_30%,rgba(14,165,233,0.15),transparent_35%)]"
          aria-hidden="true"
        ></div>
        <canvas
          id="anavi-face"
          class="h-full w-full"
          aria-label="Interactive 3D sculpture of Anavi"
        ></canvas>
      </div>
    </div>
  </section>

  <!-- Line break divider (full width) -->
  <div class="my-16 w-full">
    <div class="line-break-container">
      <div class="line-break"></div>
    </div>
  </div>

  <!-- Blog roll section (contained) -->
  <section class="mx-auto max-w-6xl px-4 md:px-8 text-slate-900">
    <div class="mt-20 grid gap-8 md:grid-cols-[0.8fr_1.2fr] md:items-start">
      <div class="space-y-3" data-blog-header>
        <p class="text-sm uppercase tracking-[0.3em] text-slate-500" data-blog-line>Latest</p>
        <h2 class="text-3xl font-semibold text-slate-900" data-blog-line>Blog roll</h2>
        <p class="text-slate-600" data-blog-line>heheha</p>
      </div>
      <div
        class="divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-white/90 shadow-sm"
        data-stagger
      >
        {posts.map((post) => (
          <a
            class="group relative flex items-start gap-6 px-6 py-5 transition hover:bg-slate-50"
            href={`/posts/${post.slug}`}
            data-stagger-item
          >
            <div class="flex-1 space-y-2">
              <div class="flex items-center gap-2 text-xs uppercase tracking-[0.3em] text-slate-500">
                <span>{post.metadata?.category ?? 'Notes'}</span>
              </div>
              <h3 class="text-xl font-semibold text-slate-900 group-hover:text-accent-700">
                {post.title}
              </h3>
              <p class="text-sm text-slate-600 line-clamp-2">{post.description}</p>
            </div>
            <div class="text-right text-sm text-slate-500">
              <p>
                {new Date(post.publishedAt).toLocaleDateString(undefined, {
                  month: 'short',
                  day: 'numeric',
                })}
              </p>
              <p class="mt-1 text-slate-500">→</p>
            </div>
            {post.metadata?.image?.url && (
              <div class="absolute right-6 top-1/2 -translate-y-1/2 opacity-0 transition-opacity group-hover:opacity-100 pointer-events-none z-10">
                <img
                  src={post.metadata.image.url}
                  alt={post.metadata.image.alt}
                  class="h-16 w-24 rounded-lg border border-slate-200 object-cover shadow-md"
                  loading="lazy"
                />
              </div>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Full-width horizontal journey section (no max-width) -->
  <div class="w-full">
    <JourneyStrip />
  </div>
</BaseLayout>
