---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchPublishedPosts, type Post } from '../../lib/cmsdocs';

export async function getStaticPaths() {
  const posts = await fetchPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

export const prerender = true;

const { post } = Astro.props as { post: Post };
---

<BaseLayout title={post.title} description={post.description}>
  <!-- Load scroll effects -->
  <script>
    import '../../components/ScrollOrchestrator';
  </script>

  <article class="mx-auto max-w-4xl px-6 py-16 space-y-6 text-slate-900">
    <header class="space-y-3" data-reveal="up">
      <p class="text-sm uppercase tracking-[0.3em] text-slate-500">
        {post.metadata?.category ?? 'Notes'}
      </p>
      <h1 class="text-4xl font-semibold text-slate-900 sm:text-5xl" data-parallax="0.03">
        {post.title}
      </h1>
      <p class="text-slate-600">{post.description}</p>
      <p class="text-xs text-slate-500">
        {new Date(post.publishedAt).toLocaleDateString(undefined, {
          month: 'short',
          day: 'numeric',
          year: 'numeric',
        })}
      </p>
    </header>

    {post.metadata?.image?.url && (
      <div
        class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
        data-reveal="up"
      >
        <img
          src={post.metadata.image.url}
          alt={post.metadata.image.alt}
          loading="lazy"
          class="h-72 w-full object-cover"
        />
      </div>
    )}

    <div
      class="prose max-w-none text-slate-800 prose-headings:text-slate-900 prose-a:text-accent-700 prose-strong:text-slate-900 prose-li:marker:text-slate-400"
      set:html={post.content}
      data-reveal="up"
    />

    {post.metadata?.author && (
      <footer class="mt-12 pt-6 text-sm text-slate-600" data-reveal="up">
        Written by{' '}
        {post.metadata.author.url ? (
          <a class="text-accent-700" href={post.metadata.author.url}>
            {post.metadata.author.name}
          </a>
        ) : (
          post.metadata.author.name
        )}
      </footer>
    )}
  </article>
</BaseLayout>

