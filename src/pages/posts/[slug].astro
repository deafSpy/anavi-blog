---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchPublishedPosts, type Post } from '../../lib/cmsdocs';

export async function getStaticPaths() {
  const posts = await fetchPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props as { post: Post };
---

<BaseLayout title={post.title} description={post.description}>
  <article class="mx-auto max-w-4xl px-6 py-16 space-y-6">
    <header class="space-y-3">
      <p class="text-sm uppercase tracking-[0.3em] text-slate-400">{post.metadata.category}</p>
      <h1 class="text-4xl font-semibold text-slate-100 sm:text-5xl">{post.title}</h1>
      <p class="text-slate-300">{post.description}</p>
      <p class="text-xs text-slate-500">
        {new Date(post.publishedAt).toLocaleDateString(undefined, {
          month: 'short',
          day: 'numeric',
          year: 'numeric',
        })}
      </p>
    </header>

    <div class="overflow-hidden rounded-2xl border border-slate-800 bg-surface-800/60">
      <img
        src={post.metadata.image.url}
        alt={post.metadata.image.alt}
        loading="lazy"
        class="h-72 w-full object-cover"
      />
    </div>

    <div
      class="prose max-w-none text-slate-100 prose-headings:text-slate-100 prose-a:text-accent-400 prose-strong:text-slate-100 prose-li:marker:text-slate-500"
      set:html={post.content}
    />

    {post.metadata?.author && (
      <footer class="mt-12 pt-6 text-sm text-slate-400">
        Written by{' '}
        {post.metadata.author.url ? (
          <a class="text-accent-400" href={post.metadata.author.url}>
            {post.metadata.author.name}
          </a>
        ) : (
          post.metadata.author.name
        )}
      </footer>
    )}
  </article>
</BaseLayout>

