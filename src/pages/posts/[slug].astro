---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchAllPosts, type BlogPost } from '../../lib/google-docs';

export async function getStaticPaths() {
  const posts = await fetchAllPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

export const prerender = true;

const { post } = Astro.props as { post: BlogPost };
---

<BaseLayout title={post.title} description={post.description}>
  <!-- Load scroll effects -->
  <script>
    import '../../components/ScrollOrchestrator';
  </script>

  <!-- Reading Progress Bar -->
  <div class="reading-progress-bar" id="reading-progress"></div>

  <!-- ============================================
       NAVBAR - Same style as main page
       ============================================ -->
  <nav class="site-nav" data-navbar>
    <a href="/" class="site-nav__brand" data-nav-brand>
      ANAVI DASGUPTA
    </a>
    
    <div class="site-nav__links" data-nav-links>
      <a href="/#work" class="site-nav__link" data-nav-link="work">
        WORK
        <span class="site-nav__underline"></span>
      </a>
      <span class="site-nav__comma">,</span>
      <a href="/posts" class="site-nav__link site-nav__link--active" data-nav-link="blog">
        BLOG
        <span class="site-nav__underline"></span>
      </a>
      <span class="site-nav__comma">,</span>
      <a href="/#contact" class="site-nav__link" data-nav-link="contact">
        CONTACT
        <span class="site-nav__underline"></span>
      </a>
    </div>
  </nav>

  <article class="post-article mx-auto max-w-3xl px-6 pt-28 pb-24 lg:pt-32 lg:pb-32 space-y-8">
    <!-- Inline Breadcrumb -->
    <nav class="breadcrumb flex items-center gap-2 text-sm" aria-label="Breadcrumb">
      <a href="/" class="breadcrumb-link">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        <span>Home</span>
      </a>
      <svg class="w-4 h-4 text-stone-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      <a href="/posts" class="breadcrumb-link">📝 Blog</a>
      <svg class="w-4 h-4 text-stone-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      <span class="breadcrumb-current truncate max-w-xs">{post.title}</span>
    </nav>

    <header class="space-y-4 post-header">
      <p class="text-sm uppercase tracking-[0.3em] text-stone-500">
        {post.metadata?.category ?? 'Notes'}
      </p>
      <h1 class="text-4xl font-bold text-stone-900 sm:text-5xl lg:text-6xl leading-tight">
        {post.title}
      </h1>
      <p class="text-lg text-stone-600">{post.description}</p>
      <div class="flex items-center gap-4 text-sm text-stone-500">
        <time datetime={post.publishedAt}>
          {new Date(post.publishedAt).toLocaleDateString(undefined, {
            month: 'long',
            day: 'numeric',
            year: 'numeric',
          })}
        </time>
      </div>
    </header>

    {post.metadata?.image?.url && (
      <div
        class="post-image overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-lg"
      >
        <img
          src={post.metadata.image.url}
          alt={post.metadata.image.alt}
          loading="lazy"
          class="w-full h-auto object-cover"
        />
      </div>
    )}

    <div
      class="post-content prose prose-lg max-w-none prose-stone prose-headings:font-bold prose-headings:text-stone-900 prose-p:text-stone-700 prose-a:text-orange-600 prose-a:no-underline hover:prose-a:underline prose-strong:text-stone-900 prose-code:text-orange-600 prose-code:bg-orange-50 prose-code:px-1 prose-code:py-0.5 prose-code:rounded prose-pre:bg-stone-900 prose-pre:text-stone-100 prose-li:marker:text-stone-400"
      set:html={post.content}
    />

    <!-- {post.metadata?.author && (
      <footer class="post-footer mt-16 pt-8 border-t border-stone-200">
        <p class="text-sm text-stone-600">
          Written by{' '}
          {post.metadata.author.url ? (
            <a class="text-orange-600 hover:underline font-medium" href={post.metadata.author.url}>
              {post.metadata.author.name}
            </a>
          ) : (
            <span class="font-medium text-stone-900">{post.metadata.author.name}</span>
          )}
        </p>
      </footer>
    )} -->
  </article>
</BaseLayout>

<style>
  /* Reading progress bar */
  .reading-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    width: 0%;
    height: 3px;
    background: linear-gradient(90deg, #f97316, #fb923c);
    z-index: 100;
    transition: width 0.1s ease-out;
  }

  /* Post article animations */
  .post-article {
    background: linear-gradient(180deg, #fefdfb 0%, #ffffff 100%);
  }

  .post-header {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .post-image {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
  }

  .post-content {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
  }

  .post-footer {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.4s forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ============================================
     NAVBAR - Same as main page
     ============================================ */
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    padding: 1.5rem 2.5rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    background: transparent;
    mix-blend-mode: difference;
    isolation: isolate;
  }

  .site-nav__brand {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    color: white;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .site-nav__brand:hover {
    opacity: 0.6;
  }

  .site-nav__links {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.25rem;
  }

  .site-nav__comma {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 0.7rem;
    font-weight: 500;
    color: white;
    margin: 0 0.15rem;
  }

  .site-nav__link {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: white;
    text-decoration: none;
    text-transform: uppercase;
    padding: 0.15rem 0;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .site-nav__underline {
    display: block;
    width: 100%;
    height: 1px;
    background: white;
    transform: scaleX(0);
    transform-origin: center;
  }

  .site-nav__link:hover .site-nav__underline {
    transform: scaleX(1);
  }

  .site-nav__link--active .site-nav__underline {
    transform: scaleX(1);
  }

  /* Breadcrumb */
  .breadcrumb {
    opacity: 0;
    animation: fadeIn 0.5s ease 0.1s forwards;
  }

  .breadcrumb-link {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    color: #78716c;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .breadcrumb-link:hover {
    color: #1c1917;
  }

  .breadcrumb-current {
    color: #44403c;
    font-weight: 500;
  }

  @keyframes fadeIn {
    to {
      opacity: 1;
    }
  }

  /* Enhanced prose styles */
  .post-content :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .post-content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .post-content :global(p) {
    margin-bottom: 1.5rem; /* More space between paragraphs */
    line-height: 1.65; /* Tighter line spacing within paragraph */
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: 1.5rem;
  }

  .post-content :global(blockquote) {
    border-left: 4px solid #f97316;
    padding-left: 1.5rem;
    font-style: italic;
    color: #57534e;
  }

  /* Centered blog images */
  .post-content :global(img),
  .post-content :global(.blog-image) {
    display: block;
    margin: 2rem auto;
    max-width: 100%;
    height: auto;
    border-radius: 0.75rem;
  }

  /* ============================================
     MOBILE RESPONSIVE - Blog Content
     ============================================ */
  @media (max-width: 768px) {
    .post-article {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .post-content :global(p) {
      font-size: 1rem;
      line-height: 1.7;
      margin-bottom: 1.25rem;
      /* Ensure proper text flow on mobile */
      word-break: break-word;
      overflow-wrap: break-word;
      hyphens: auto;
    }

    .post-content :global(h1) {
      font-size: 1.75rem;
    }

    .post-content :global(h2) {
      font-size: 1.5rem;
      margin-top: 2rem;
    }

    .post-content :global(h3) {
      font-size: 1.25rem;
      margin-top: 1.5rem;
    }

    .post-content :global(ul),
    .post-content :global(ol) {
      padding-left: 1.25rem;
    }

    .post-content :global(blockquote) {
      padding-left: 1rem;
      margin-left: 0;
      margin-right: 0;
    }
  }

</style>

<script>
  // Reading progress bar
  function updateReadingProgress() {
    const progressBar = document.getElementById('reading-progress');
    if (!progressBar) return;

    const article = document.querySelector('.post-content');
    if (!article) return;

    const windowHeight = window.innerHeight;
    const articleTop = article.getBoundingClientRect().top + window.scrollY;
    const articleHeight = (article as HTMLElement).offsetHeight;
    const scrollPosition = window.scrollY;

    // Calculate progress
    const startReading = articleTop - windowHeight * 0.3;
    const endReading = articleTop + articleHeight;
    const totalReadingDistance = endReading - startReading;
    const currentProgress = scrollPosition - startReading;
    const progressPercentage = Math.max(0, Math.min(100, (currentProgress / totalReadingDistance) * 100));

    progressBar.style.width = `${progressPercentage}%`;
  }

  // Initialize on page load
  function initReadingProgress() {
    updateReadingProgress();
    window.addEventListener('scroll', updateReadingProgress, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initReadingProgress);
  } else {
    initReadingProgress();
  }

  // Re-initialize on Astro page transitions
  document.addEventListener('astro:page-load', initReadingProgress);
</script>
