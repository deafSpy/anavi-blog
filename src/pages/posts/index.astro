---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchPublishedPosts } from '../../lib/cmsdocs';

export const prerender = true;

const posts = await fetchPublishedPosts();
---

<BaseLayout title="Posts" description="Browse all updates and field notes">
  <!-- Load scroll effects -->
  <script>
    import '../../components/ScrollOrchestrator';
  </script>

  <!-- ============================================
       NAVBAR - Same as main page
       ============================================ -->
  <nav
    class="nav-glass fixed top-4 left-1/2 -translate-x-1/2 z-50 flex items-center gap-8 rounded-full px-6 py-3"
    data-navbar
  >
    <a href="/" class="flex items-center gap-2">
      <span class="text-lg font-bold tracking-tight text-stone-900">Anavi</span>
    </a>
    
    <div class="nav-links flex items-center gap-1">
      <div class="nav-pill"></div>
      <a class="nav-link nav-link-active" href="/posts">Blog</a>
      <a class="nav-link" href="/#about">About</a>
      <a class="nav-link" href="/#contact">Contact</a>
    </div>
  </nav>

  <div class="posts-page min-h-screen">
    <!-- Decorative background -->
    <div class="posts-bg" aria-hidden="true"></div>

    <section class="relative mx-auto max-w-4xl px-6 pt-28 pb-24 lg:pt-32 lg:pb-32">
      <!-- Breadcrumb + Header inline -->
      <header class="mb-12 posts-header">
        <nav class="breadcrumb flex items-center gap-2 text-sm mb-6" aria-label="Breadcrumb">
          <a href="/" class="breadcrumb-link">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            <span>Home</span>
          </a>
          <svg class="w-4 h-4 text-stone-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
          <span class="breadcrumb-current">📝 Blog</span>
        </nav>
        
        <h1 class="text-4xl font-bold text-stone-900 sm:text-5xl mb-4">
          All posts
        </h1>
        <p class="text-stone-600 max-w-lg">
          Stories, experiments, and reflections from the field.
        </p>
      </header>

      <div class="grid gap-5 posts-grid">
        {posts.map((post, index) => (
          <article
            class="post-card"
            style={`--card-index: ${index}`}
          >
            <a 
              href={`/posts/${post.slug}`}
              class="block p-6 h-full"
            >
              <div class="flex items-start justify-between gap-4">
                <div class="space-y-2 flex-1">
                  <p class="text-xs uppercase tracking-[0.2em] text-stone-500">
                    {post.metadata?.category ?? 'Notes'}
                  </p>
                  <h2 class="text-xl font-semibold text-stone-900 group-hover:text-orange-600 transition-colors">
                    {post.title}
                  </h2>
                  <p class="text-stone-600 line-clamp-2">
                    {post.description}
                  </p>
                </div>
                <div class="text-right shrink-0">
                  <p class="text-sm font-medium text-stone-500">
                    {new Date(post.publishedAt).toLocaleDateString(undefined, {
                      month: 'short',
                      day: 'numeric',
                    })}
                  </p>
                  <div class="mt-3 w-8 h-8 rounded-full bg-stone-100 flex items-center justify-center text-stone-400 post-arrow">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                  </div>
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .posts-page {
    background: linear-gradient(180deg, #fefdfb 0%, #faf9f7 50%, #f5f4f2 100%);
    position: relative;
  }

  .posts-bg {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse 60% 40% at 30% 20%, rgba(249, 115, 22, 0.04), transparent),
      radial-gradient(ellipse 50% 30% at 70% 80%, rgba(14, 165, 233, 0.03), transparent);
    pointer-events: none;
  }

  /* Navbar active state */
  .nav-link-active {
    color: var(--text-primary, #0c0a09);
  }

  /* Breadcrumb */
  .breadcrumb {
    opacity: 0;
    animation: fadeIn 0.5s ease 0.1s forwards;
  }

  .breadcrumb-link {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    color: #78716c;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .breadcrumb-link:hover {
    color: #1c1917;
  }

  .breadcrumb-current {
    color: #44403c;
    font-weight: 500;
  }

  /* Header animation */
  .posts-header {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* Grid animation */
  .posts-grid {
    opacity: 0;
    animation: fadeIn 0.5s ease 0.3s forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeIn {
    to {
      opacity: 1;
    }
  }

  /* Post cards */
  .post-card {
    background: white;
    border-radius: 1rem;
    border: 1px solid rgba(0, 0, 0, 0.04);
    box-shadow: 
      0 1px 2px rgba(0, 0, 0, 0.02),
      0 4px 12px rgba(0, 0, 0, 0.04);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    opacity: 0;
    transform: translateY(15px);
    animation: cardReveal 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(0.4s + var(--card-index) * 0.08s);
  }

  @keyframes cardReveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: 
      0 4px 8px rgba(0, 0, 0, 0.04),
      0 16px 32px rgba(0, 0, 0, 0.08);
    border-color: rgba(249, 115, 22, 0.2);
  }

  .post-card a {
    display: block;
  }

  .post-card:hover h2 {
    color: #ea580c;
  }

  .post-card:hover .post-arrow {
    background: rgba(249, 115, 22, 0.1);
    color: #ea580c;
  }
</style>
