import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchPublishedPosts } from '../../lib/cmsdocs';

const posts = await fetchPublishedPosts();
---

<BaseLayout title="Posts" description="Browse all updates and field notes">
  <section class="mx-auto max-w-4xl px-6 py-16 space-y-10">
    <header class="space-y-3">
      <p class="text-sm uppercase tracking-[0.3em] text-slate-400">Journal</p>
      <h1 class="text-3xl font-semibold text-slate-100 sm:text-4xl">All posts</h1>
      <p class="text-slate-300">Stories fetched from CMSDocs with a fallback starter post.</p>
    </header>

    <div class="grid gap-6">
      {posts.map((post) => (
        <article class="rounded-2xl border border-slate-800 bg-surface-800/60 p-5 shadow-lg shadow-black/30">
          <p class="text-xs uppercase tracking-[0.2em] text-slate-400">{post.metadata.category}</p>
          <h2 class="mt-2 text-xl font-semibold text-slate-100">{post.title}</h2>
          <p class="mt-2 text-slate-300">{post.description}</p>
          <a class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-accent-400" href={`/posts/${post.slug}`}>
            Read →
          </a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

