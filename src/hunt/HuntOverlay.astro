        const div = container as HTMLElement;
        const index = parseInt(div.dataset.index || '0');
        
        if (selected.has(index)) {
          selected.delete(index);
          container.classList.remove('selected');
        } else {
          selected.add(index);
          container.classList.add('selected');
        }
      });
    });

    // Submit handler
    if (submitBtn) {
      submitBtn.addEventListener('click', async () => {
        // Check if selection matches correct images
        const correctIndices = images
          .map((img: any, i: number) => img.isCorrect ? i : -1)
          .filter((i: number) => i !== -1);
        
        const selectedArray = Array.from(selected).sort();
        const correctArray = correctIndices.sort();
        
        const isCorrect = selectedArray.length === correctArray.length &&
                         selectedArray.every((val, i) => val === correctArray[i]);

        if (isCorrect) {
          solvedStages.add(currentStageIndex);
          saveProgress();
          updateNavigation();
          await showSuccessMessage(stage.successMessage || 'Identity verified! ♡');
          
          if (currentStageIndex < huntStages.length - 1) {
            await goToStage(currentStageIndex + 1, 'next');
          }
        } else {
          // Error shake
          gsap.to('.captcha-card', {
            x: -8,
            duration: 0.4,
            ease: 'power2.inOut',
            repeat: 3,
            yoyo: true
          });
          
          if (errorEl) {
            errorEl.textContent = 'Not quite... try again ♡';
            errorEl.style.opacity = '1';
          }
        }
      });
    }

    // Initialize PASS bypass for captcha
    initPassBypass(() => {
      // Auto-select all correct images
      const correctIndices = images
        .map((img: any, i: number) => img.isCorrect ? i : -1)
        .filter((i: number) => i !== -1);
      
      selected.clear();
      correctIndices.forEach((index: number) => {
        selected.add(index);
        const container = gridEl?.querySelector(`[data-index="${index}"]`);
        container?.classList.add('selected');
      });
      
      // Trigger submit
      submitBtn?.click();
    });
  }

  // ============================================
  // Typewriter Effect
  // ============================================
  function typewriterEffect(element: HTMLElement | null, text: string, speed = 50, callback: (() => void) | null = null) {
    if (!element || !text) {
      if (callback) callback();
      return;
    }
    
    let index = 0;
    element.textContent = '';
    
    const type = () => {
      if (index < text.length) {
        element.textContent += text[index];
        index++;
        setTimeout(type, speed);
      } else if (callback) {
        callback();
      }
    };
    
    type();
  }

  // ============================================
  // Event Listeners
  // ============================================
  if (exitBtn) exitBtn.addEventListener('click', deactivateHunt);
  
  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      localStorage.removeItem(STORAGE_KEY);
      localStorage.removeItem(SOLVED_KEY);
      currentStageIndex = 0;
      solvedStages = new Set();
      stagePhase = 'puzzle';
      renderCurrentStage();
      updateProgress();
      updateNavigation();
    });
  }

  // ESC key to exit
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isActive) {
      deactivateHunt();
    }
  });

  // ============================================
  // Initialization
  // ============================================
  function initHunt() {
    try {
      // Re-query elements to ensure they exist
      const overlay = document.getElementById('hunt-overlay');
      if (!overlay) return;
      
      // Initialize music player controls
      initMusicPlayer();

      // Check if we're on the dedicated /hunt page (auto-activate)
      const isHuntPage = window.location.pathname === '/hunt' || window.location.pathname === '/hunt/';
      
      if (isHuntPage || DEBUG_MODE) {
        // Skip cipher animation since it played before redirect
        activateHuntDirect();
      } else {
        // Main page - use Konami listener (handled by KonamiTrigger.ts instead)
        initKonamiListener();
      }
      
      // Listen for custom activation event from hunt.astro
      window.addEventListener('activateHunt', () => {
        activateHuntDirect();
      });
    } catch (e) {
      console.warn('HuntOverlay init failed:', e);
    }
  }
  
  // Direct activation without cipher animation (already played)
  async function activateHuntDirect() {
    if (overlay) overlay.setAttribute('data-active', 'true');
    isActive = true;
    
    loadProgress();
    renderCurrentStage();
    updateProgress();
    updateNavigation();
    
    // Initialize image trail for completed puzzles
    await initImageTrail('stage-container');
    
    // Load music from pre-scanned list (embedded at build time)
    const musicFilesAttr = overlay?.getAttribute('data-music-files');
    if (musicFilesAttr) {
      try {
        const songs = JSON.parse(musicFilesAttr) as string[];
        if (songs.length > 0) {
          startMusicPlaylist(songs);
        }
      } catch (e) {
        console.log('Could not parse music files');
      }
    }
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHunt);
  } else {
    initHunt();
  }
</script>

