  // ============================================
  // Render Love Wordle Puzzle
  // ============================================
  function renderLoveWordle(stage: any) {
    const answer = (stage.answer || 'SMILE').toUpperCase();
    const maxAttempts = 6;
    let currentAttempt = 0;
    let currentGuess = '';

    const html = `
      <div class="love-wordle-puzzle">
        <div class="wordle-card terminal-frame">
          <div class="terminal-header">
            <div class="terminal-dots">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
            </div>
            <span class="terminal-title">✧ love wordle ✧</span>
          </div>
          <div class="terminal-content">
            <div class="puzzle-prompt" id="wordle-prompt"></div>
            <div class="puzzle-subtext" id="wordle-subtext"></div>
            
            <div class="wordle-grid" id="wordle-grid">
              ${Array.from({ length: maxAttempts }, (_, i) => `
                <div class="wordle-row" data-row="${i}">
                  ${Array.from({ length: answer.length }, () => `
                    <div class="wordle-cell"></div>
                  `).join('')}
                </div>
              `).join('')}
            </div>
            
            <div class="wordle-keyboard" id="wordle-keyboard"></div>
            
            <div class="wordle-status" id="wordle-status"></div>
            
            ${stage.hint ? `
              <div class="hint-container">
                <button type="button" class="hint-toggle" id="hint-toggle">need a hint?</button>
                <div class="hint-text" id="hint-text">${stage.hint}</div>
              </div>
            ` : ''}
          </div>
        </div>
      </div>
    `;

    if (stageContainer) stageContainer.innerHTML = html;

    const promptEl = document.getElementById('wordle-prompt');
    const subtextEl = document.getElementById('wordle-subtext');
    const gridEl = document.getElementById('wordle-grid');
    const keyboardEl = document.getElementById('wordle-keyboard');
    const statusEl = document.getElementById('wordle-status');
    const hintToggle = document.getElementById('hint-toggle');
    const hintText = document.getElementById('hint-text');

    // Typewriter effects
    if (promptEl && stage.prompt) {
      typewriterEffect(promptEl, stage.prompt, 40, () => {
        if (subtextEl && stage.subtext) {
          typewriterEffect(subtextEl, stage.subtext, 25);
        }
      });
    }

    // Hint toggle
    if (hintToggle && hintText) {
      hintToggle.addEventListener('click', () => {
        hintText.classList.toggle('visible');
        hintToggle.textContent = hintText.classList.contains('visible') ? 'hide hint' : 'need a hint?';
      });
    }

    // Create keyboard
    const keyboard = 'QWERTYUIOPASDFGHJKLZXCVBNM'.split('');
    if (keyboardEl) {
      keyboardEl.innerHTML = keyboard.map(letter => 
        `<button class="wordle-key" data-key="${letter}">${letter}</button>`
      ).join('') + 
      `<button class="wordle-key wordle-key-enter" data-key="ENTER">ENTER</button>
       <button class="wordle-key wordle-key-back" data-key="BACK">⌫</button>`;
    }

    // Handle key press
    function handleKey(key: string) {
      if (key === 'ENTER') {
        if (currentGuess.length === answer.length) {
          submitGuess();
        }
      } else if (key === 'BACK') {
        currentGuess = currentGuess.slice(0, -1);
        updateCurrentRow();
      } else if (currentGuess.length < answer.length && /^[A-Z]$/.test(key)) {
        currentGuess += key;
        updateCurrentRow();
      }
    }

    // Update current row
    function updateCurrentRow() {
      if (!gridEl) return;
      const row = gridEl.querySelector(`[data-row="${currentAttempt}"]`);
      if (!row) return;
      
      const cells = row.querySelectorAll('.wordle-cell');
      cells.forEach((cell, i) => {
        cell.textContent = currentGuess[i] || '';
      });
    }

    // Submit guess
    async function submitGuess() {
      if (!gridEl) return;
      const row = gridEl.querySelector(`[data-row="${currentAttempt}"]`);
      if (!row) return;
      
      const cells = row.querySelectorAll('.wordle-cell');
      const guessArray = currentGuess.split('');
      const answerArray = answer.split('');
      const used = new Array(answer.length).fill(false);

      // First pass: mark correct positions
      cells.forEach((cell, i) => {
        if (guessArray[i] === answerArray[i]) {
          cell.classList.add('correct');
          used[i] = true;
        }
      });

      // Second pass: mark present letters
      cells.forEach((cell, i) => {
        if (!cell.classList.contains('correct')) {
          const letterIndex = answerArray.findIndex((l: string, idx: number) => l === guessArray[i] && !used[idx]);
          if (letterIndex !== -1) {
            cell.classList.add('present');
            used[letterIndex] = true;
          } else {
            cell.classList.add('absent');
          }
        }
      });

      // Animate cells
      cells.forEach((cell, i) => {
        gsap.from(cell, {
          rotateX: 90,
          duration: 0.3,
          delay: i * 0.1,
          ease: 'power2.out'
        });
      });

      // Check win
      if (currentGuess === answer) {
        solvedStages.add(currentStageIndex);
        saveProgress();
        updateNavigation();
        
        await showSuccessMessage(stage.successMessage || 'You got it! ♡');
        
        if (currentStageIndex < huntStages.length - 1) {
          await goToStage(currentStageIndex + 1, 'next');
        }
        return;
      }

      // Check loss
      currentAttempt++;
      if (currentAttempt >= maxAttempts) {
        if (statusEl) {
          statusEl.textContent = `The word was: ${answer}. Try again!`;
          statusEl.style.opacity = '1';
        }
        
        // Allow reset
        setTimeout(() => {
          currentAttempt = 0;
          currentGuess = '';
          if (gridEl) {
            gridEl.querySelectorAll('.wordle-cell').forEach(cell => {
              cell.textContent = '';
              cell.className = 'wordle-cell';
            });
          }
          if (statusEl) statusEl.style.opacity = '0';
        }, 3000);
      } else {
        currentGuess = '';
      }
    }

    // Keyboard click handlers
    keyboardEl?.querySelectorAll('.wordle-key').forEach(key => {
      key.addEventListener('click', () => {
        const btn = key as HTMLElement;
        const k = btn.dataset.key || '';
        handleKey(k);
      });
    });

    // Physical keyboard
    document.addEventListener('keydown', (e) => {
      if (!isActive) return;
      
      const key = e.key.toUpperCase();
      if (key === 'ENTER') {
        handleKey('ENTER');
      } else if (key === 'BACKSPACE') {
        handleKey('BACK');
      } else if (/^[A-Z]$/.test(key)) {
        handleKey(key);
      }
    });

    // Initialize PASS bypass for wordle
    initPassBypass(() => {
      // Auto-complete with the correct answer
      const answer = (stage.answer || 'SMILE').toUpperCase();
      currentGuess = answer;
      submitGuess();
    });
  }

