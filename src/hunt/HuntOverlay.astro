---
/**
 * HuntOverlay.astro - Main Treasure Hunt Overlay Component
 * Romantic Theme with Combined Puzzle + Memory Lane Stages
 * Uses GSAP for animations and Lenis for smooth scroll
 */

interface Props {
  musicFiles?: string[];
}

const { musicFiles = [] } = Astro.props;
---

<!-- Hunt Overlay Container -->
<div id="hunt-overlay" class="hunt-overlay" data-active="false" data-music-files={JSON.stringify(musicFiles)}>
  <!-- Transition Layer with Loading Animation -->
  <div id="transition-layer" class="transition-layer">
    <div class="transition-loader">
      <div class="loader-heart">♡</div>
      <div class="loader-text">Loading...</div>
    </div>
  </div>

  <!-- Main Hunt Container -->
  <div id="hunt-container" class="hunt-container">
    <!-- Header with Navigation -->
    <header class="hunt-header">
      <button id="nav-prev" class="nav-arrow nav-prev" disabled aria-label="Previous">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M15 18l-6-6 6-6"/>
        </svg>
      </button>
      
      <div class="hunt-title-area">
        <span id="hunt-progress-text" class="hunt-progress-text">[1/7]</span>
        <div class="hunt-progress-bar">
          <div id="hunt-progress-fill" class="hunt-progress-fill"></div>
        </div>
      </div>
      
      <button id="nav-next" class="nav-arrow nav-next" disabled aria-label="Next">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 18l6-6-6-6"/>
        </svg>
      </button>
    </header>

    <!-- Exit Button -->
    <button id="hunt-exit" class="hunt-exit">[ESC] EXIT</button>

    <!-- Reset Button (Debug) -->
    <button id="hunt-reset" class="hunt-reset">[RESET]</button>

    <!-- Stage Container - Slider for smooth transitions -->
    <div id="stage-container" class="stage-container">
      <div id="stage-slider" class="stage-slider"></div>
    </div>

    <!-- Success Message Overlay -->
    <div id="success-overlay" class="success-overlay">
      <div id="success-message" class="success-message"></div>
    </div>
    
    <!-- Music Player (Spotify-style) -->
    <div id="music-player" class="music-player">
      <audio id="music-audio"></audio>
      
      <!-- Controls -->
      <div class="music-controls">
        <button id="music-prev" class="music-btn" aria-label="Previous">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
            <path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/>
          </svg>
        </button>
        
        <button id="music-toggle" class="music-btn music-play-btn" aria-label="Play/Pause">
          <svg class="icon-play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8 5v14l11-7z"/>
          </svg>
          <svg class="icon-pause" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
          </svg>
        </button>
        
        <button id="music-next" class="music-btn" aria-label="Next">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
            <path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/>
          </svg>
        </button>
      </div>
      
      <!-- Track Info & Progress -->
      <div class="music-track">
        <span id="music-title" class="music-title">♪</span>
        <div class="music-progress">
          <div id="music-progress-fill" class="music-progress-fill"></div>
        </div>
      </div>
      
      <!-- Volume -->
      <div class="music-volume-wrap">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" opacity="0.6">
          <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/>
        </svg>
        <input type="range" id="music-volume" class="music-volume" min="0" max="1" step="0.1" value="0.5" />
      </div>
    </div>
  </div>
</div>

<style>
  .hunt-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--hunt-bg, #1a1418);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE/Edge */
  }

  .hunt-overlay::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }

  .hunt-overlay[data-active="true"] {
    opacity: 1;
    visibility: visible;
  }

  /* Transition Layer with Loading Animation */
  .transition-layer {
    position: fixed;
    inset: 0;
    z-index: 10000;
    background: var(--hunt-bg, #1a1418);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .transition-layer.active {
    opacity: 1;
    pointer-events: auto;
  }

  .transition-loader {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    opacity: 0;
    transform: scale(0.9);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .transition-layer.active .transition-loader {
    opacity: 1;
    transform: scale(1);
  }

  .loader-heart {
    font-size: 2.5rem;
    color: var(--hunt-primary, #d4a5d9);
    animation: heartPulse 1s ease-in-out infinite;
    text-shadow: 0 0 20px var(--hunt-glow, rgba(212, 165, 217, 0.5));
  }

  @keyframes heartPulse {
    0%, 100% {
      transform: scale(1);
      opacity: 0.8;
    }
    50% {
      transform: scale(1.2);
      opacity: 1;
    }
  }

  .loader-text {
    font-size: 0.75rem;
    color: var(--hunt-primary-dim, rgba(212, 165, 217, 0.6));
    letter-spacing: 0.15em;
    text-transform: uppercase;
    animation: fadeInOut 1.5s ease-in-out infinite;
  }

  @keyframes fadeInOut {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 1; }
  }

  /* Hunt Container */
  .hunt-container {
    position: relative;
    width: 100%;
    min-height: 100vh;
    padding-top: 4rem;
    padding-bottom: 2rem;
    overflow: hidden;
  }

  /* Header with Navigation */
  .hunt-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 0.75rem 1.5rem;
    background: linear-gradient(to bottom, var(--hunt-bg, #1a1418) 0%, transparent 100%);
  }

  .hunt-title-area {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
  }

  .hunt-progress-text {
    font-size: 0.75rem;
    color: var(--hunt-primary-dim, rgba(212, 165, 217, 0.7));
  }

  .hunt-progress-bar {
    width: 6rem;
    height: 3px;
    background: var(--hunt-primary-faint, rgba(212, 165, 217, 0.15));
    border-radius: 2px;
    overflow: hidden;
  }

  .hunt-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--hunt-primary, #d4a5d9), var(--hunt-accent, #e8b4bc));
    width: 0%;
    transition: width 0.5s ease;
  }

  /* Navigation Arrows */
  .nav-arrow {
    width: 36px;
    height: 36px;
    border: 1px solid var(--hunt-border, rgba(212, 165, 217, 0.25));
    border-radius: 50%;
    background: transparent;
    color: var(--hunt-primary, #d4a5d9);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .nav-arrow:hover:not(:disabled) {
    background: var(--hunt-primary-faint, rgba(212, 165, 217, 0.15));
    border-color: var(--hunt-primary, #d4a5d9);
    transform: scale(1.05);
  }

  .nav-arrow:disabled {
    opacity: 0.25;
    cursor: not-allowed;
  }

  /* Exit & Reset Buttons */
  .hunt-exit {
    position: fixed;
    top: 0.75rem;
    right: 1rem;
    z-index: 101;
    background: none;
    border: none;
    color: var(--hunt-primary-dim, rgba(212, 165, 217, 0.5));
    font-family: inherit;
    font-size: 0.7rem;
    cursor: pointer;
    transition: color 0.3s ease;
  }

  .hunt-exit:hover {
    color: var(--hunt-primary, #d4a5d9);
  }

  .hunt-reset {
    position: fixed;
    bottom: 1rem;
    left: 1rem;
    z-index: 50;
    background: none;
    border: none;
    color: var(--hunt-danger, rgba(224, 122, 122, 0.3));
    font-family: inherit;
    font-size: 0.625rem;
    cursor: pointer;
    transition: color 0.3s ease;
  }

  .hunt-reset:hover {
    color: var(--hunt-danger, #e07a7a);
  }

  /* Stage Container - Viewport for the carousel */
  .stage-container {
    width: 100vw;
    height: calc(100vh - 4rem);
    position: relative;
    overflow: hidden;
  }

  /* Stage Slider - Horizontal track that moves */
  .stage-slider {
    display: flex;
    flex-direction: row;
    height: 100%;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Individual Stage Slide - Each takes full viewport width */
  .stage-slide {
    flex: 0 0 100vw;
    width: 100vw;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 2rem;
    box-sizing: border-box;
    overflow-y: auto;
  }

  /* Success Overlay */
  .success-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(26, 20, 24, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .success-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .success-message {
    color: var(--hunt-accent, #e8b4bc);
    font-size: 1.25rem;
    text-align: center;
    text-shadow: 0 0 30px var(--hunt-glow, rgba(212, 165, 217, 0.4));
  }

  /* Soft vignette */
  .hunt-overlay::after {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse at center,
      transparent 0%,
      transparent 50%,
      rgba(26, 20, 24, 0.5) 100%
    );
    z-index: 50;
  }

  /* ============================================
     Music Player (Spotify-style)
     ============================================ */
  .music-player {
    position: fixed;
    bottom: 1.25rem;
    right: 1.25rem;
    z-index: 200;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.875rem;
    background: rgba(18, 14, 16, 0.95);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(212, 165, 217, 0.15);
    border-radius: 8px;
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.3s ease;
    pointer-events: none;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }

  .music-player.visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .music-controls {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .music-btn {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.7);
    cursor: pointer;
    transition: all 0.15s ease;
    border-radius: 50%;
  }

  .music-btn:hover {
    color: white;
    transform: scale(1.1);
  }

  .music-play-btn {
    width: 28px;
    height: 28px;
    background: white;
    color: #121212;
  }

  .music-play-btn:hover {
    transform: scale(1.05);
    color: #121212;
  }

  .music-player .icon-play,
  .music-player .icon-pause {
    display: none;
  }

  .music-player:not(.playing) .icon-play {
    display: block;
  }

  .music-player.playing .icon-pause {
    display: block;
  }

  .music-track {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 100px;
    max-width: 140px;
  }

  .music-title {
    font-size: 0.7rem;
    font-weight: 500;
    color: white;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    letter-spacing: 0.01em;
  }

  .music-progress {
    width: 100%;
    height: 3px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 3px;
    overflow: hidden;
    cursor: pointer;
  }

  .music-progress-fill {
    height: 100%;
    width: 0%;
    background: var(--hunt-primary, #d4a5d9);
    border-radius: 3px;
    transition: width 0.1s linear;
  }

  .music-volume-wrap {
    display: flex;
    align-items: center;
    gap: 4px;
    color: rgba(255, 255, 255, 0.6);
  }

  .music-volume {
    width: 50px;
    height: 3px;
    -webkit-appearance: none;
    appearance: none;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 3px;
    cursor: pointer;
  }

  .music-volume::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 10px;
    height: 10px;
    background: white;
    border-radius: 50%;
    cursor: pointer;
    transition: transform 0.1s;
  }

  .music-volume::-webkit-slider-thumb:hover {
    transform: scale(1.2);
  }

  .music-volume::-moz-range-thumb {
    width: 10px;
    height: 10px;
    background: white;
    border: none;
    border-radius: 50%;
    cursor: pointer;
  }

  @media (max-width: 640px) {
    .music-player {
      bottom: 0.75rem;
      right: 0.75rem;
      left: 0.75rem;
      border-radius: 6px;
    }
    
    .music-track {
      flex: 1;
      max-width: none;
    }
    
    .music-volume-wrap {
      display: none;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { huntStages, DEBUG_MODE, KONAMI_SEQUENCE } from './GameConfig.js';
  import { playCipherAnimation } from '../components/CipherGlitch';
  import { initImageTrail, startTrail, stopTrail, destroyImageTrail } from '../components/ImageTrail';
  import { initPassBypass, destroyPassBypass, resetBypassProgress } from '../components/PassBypass';

  // ============================================
  // Hunt Engine State
  // ============================================
  const STORAGE_KEY = 'hunt_progress';
  const SOLVED_KEY = 'hunt_solved';
  
  let currentStageIndex = 0;
  let solvedStages = new Set<number>();
  let stagePhase = 'puzzle'; // 'puzzle' or 'memory'
  let isActive = false;
  let konamiProgress: string[] = [];
  let lenisInstance: any = null;

  // DOM Elements
  const overlay = document.getElementById('hunt-overlay');
  const transitionLayer = document.getElementById('transition-layer');
  const stageContainer = document.getElementById('stage-container');
  const stageSlider = document.getElementById('stage-slider');
  const progressText = document.getElementById('hunt-progress-text');
  const progressFill = document.getElementById('hunt-progress-fill');
  const successOverlay = document.getElementById('success-overlay');
  const successMessage = document.getElementById('success-message');
  const exitBtn = document.getElementById('hunt-exit');
  const resetBtn = document.getElementById('hunt-reset');
  const navPrev = document.getElementById('nav-prev');
  const navNext = document.getElementById('nav-next');
  
  // Slider state
  let slideCache = new Map<number, HTMLElement>();
  let isSliding = false;
  
  // Music Player Elements
  const musicPlayer = document.getElementById('music-player');
  const musicAudio = document.getElementById('music-audio') as HTMLAudioElement;
  const musicToggle = document.getElementById('music-toggle');
  const musicPrev = document.getElementById('music-prev');
  const musicNext = document.getElementById('music-next');
  const musicTitle = document.getElementById('music-title');
  const musicProgressFill = document.getElementById('music-progress-fill');
  const musicVolume = document.getElementById('music-volume') as HTMLInputElement;
  
  // Music playlist state
  let musicPlaylist: string[] = [];
  let musicTitles: string[] = [];
  let currentTrackIndex = 0;
  let musicIsPlaying = false;

  // ============================================
  // Konami Code Detection
  // ============================================
  function initKonamiListener() {
    document.addEventListener('keydown', (e) => {
      if (isActive) return;

      const key = e.key.length === 1 ? e.key.toLowerCase() : e.key;
      konamiProgress.push(key);

      const targetSlice = KONAMI_SEQUENCE.slice(0, konamiProgress.length);
      const matches = targetSlice.every((k, i) => {
        const target = k.length === 1 ? k.toLowerCase() : k;
        return target === konamiProgress[i];
      });

      if (!matches) {
        konamiProgress = [];
        return;
      }

      if (konamiProgress.length === KONAMI_SEQUENCE.length) {
        konamiProgress = [];
        activateHunt();
      }
    });
  }

  // ============================================
  // Music Player Functions
  // ============================================
  function initMusicPlayer() {
    if (!musicAudio || !musicToggle || !musicVolume) return;
    
    // Set initial volume
    musicAudio.volume = parseFloat(musicVolume.value);
    
    // Toggle play/pause
    musicToggle.addEventListener('click', () => {
      if (musicAudio.paused) {
        musicAudio.play().catch(() => {});
        musicPlayer?.classList.add('playing');
        musicIsPlaying = true;
      } else {
        musicAudio.pause();
        musicPlayer?.classList.remove('playing');
        musicIsPlaying = false;
      }
    });
    
    // Previous track
    musicPrev?.addEventListener('click', () => {
      if (musicPlaylist.length === 0) return;
      currentTrackIndex = (currentTrackIndex - 1 + musicPlaylist.length) % musicPlaylist.length;
      loadTrack(currentTrackIndex);
      if (musicIsPlaying) musicAudio.play().catch(() => {});
    });
    
    // Next track
    musicNext?.addEventListener('click', () => {
      if (musicPlaylist.length === 0) return;
      currentTrackIndex = (currentTrackIndex + 1) % musicPlaylist.length;
      loadTrack(currentTrackIndex);
      if (musicIsPlaying) musicAudio.play().catch(() => {});
    });
    
    // Volume control
    musicVolume.addEventListener('input', () => {
      musicAudio.volume = parseFloat(musicVolume.value);
    });
    
    // Update progress bar
    musicAudio.addEventListener('timeupdate', () => {
      if (musicProgressFill && musicAudio.duration) {
        const progress = (musicAudio.currentTime / musicAudio.duration) * 100;
        musicProgressFill.style.width = `${progress}%`;
      }
    });
    
    // Auto-play next track when current ends
    musicAudio.addEventListener('ended', () => {
      if (musicPlaylist.length === 0) return;
      currentTrackIndex = (currentTrackIndex + 1) % musicPlaylist.length;
      loadTrack(currentTrackIndex);
      musicAudio.play().catch(() => {});
    });
  }
  
  function loadTrack(index: number) {
    if (!musicAudio || !musicTitle || musicPlaylist.length === 0) return;
    
    musicAudio.src = musicPlaylist[index];
    musicAudio.load();
    musicTitle.textContent = musicTitles[index] || `Track ${index + 1}`;
    if (musicProgressFill) musicProgressFill.style.width = '0%';
  }
  
  // Shuffle array helper
  function shuffleArray<T>(array: T[]): T[] {
    const shuffled = [...array];
    for (let i = shuffled.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
    }
    return shuffled;
  }
  
  // Extract readable title from filename
  function getTitleFromPath(path: string): string {
    const filename = path.split('/').pop() || '';
    // Remove extension and replace underscores/dashes with spaces
    return filename
      .replace(/\.(mp3|wav|ogg|m4a)$/i, '')
      .replace(/[-_]/g, ' ')
      .replace(/\b\w/g, c => c.toUpperCase()); // Title case
  }
  
  // Load music from folder (uses predefined list since browser can't read directories)
  async function loadMusicFromFolder(folderPath: string) {
    // Since browsers can't list directory contents, we need a manifest
    // Try to fetch a music.json file that lists the songs
    try {
      const response = await fetch(`${folderPath}/music.json`);
      if (response.ok) {
        const data = await response.json();
        const songs = data.songs.map((s: string) => `${folderPath}/${s}`);
        const titles = songs.map((s: string) => getTitleFromPath(s));
        
        // Shuffle and start
        const indices = shuffleArray([...Array(songs.length).keys()]);
        musicPlaylist = indices.map((i: number) => songs[i]);
        musicTitles = indices.map((i: number) => titles[i]);
        currentTrackIndex = 0;
        
        if (musicPlaylist.length > 0 && musicPlayer) {
          loadTrack(0);
          musicPlayer.classList.add('visible');
        }
      } else {
        console.log('No music.json found. Create one with: { "songs": ["song1.mp3", "song2.mp3"] }');
      }
    } catch (e) {
      console.log('Music folder not configured. Add music.json to', folderPath);
    }
  }
  
  function startMusicPlaylist(songs: string[], titles?: string[]) {
    // Shuffle the songs
    const indices = shuffleArray([...Array(songs.length).keys()]);
    musicPlaylist = indices.map(i => songs[i]);
    musicTitles = titles 
      ? indices.map(i => titles[i]) 
      : indices.map(i => getTitleFromPath(songs[i]));
    currentTrackIndex = 0;
    
    if (musicPlaylist.length > 0 && musicPlayer) {
      loadTrack(0);
      musicPlayer.classList.add('visible');
    }
  }
  
  function stopMusic() {
    if (!musicAudio || !musicPlayer) return;
    musicAudio.pause();
    musicAudio.currentTime = 0;
    musicPlayer.classList.remove('visible', 'playing');
    musicIsPlaying = false;
  }

  // ============================================
  // Transition Animation
  // ============================================
  function playTransition(): Promise<void> {
    return new Promise((resolve) => {
      if (!transitionLayer) { resolve(); return; }
      
      transitionLayer.classList.add('active');
      
      // Longer transition for smoother feel
      setTimeout(() => {
        transitionLayer.classList.remove('active');
        resolve();
      }, 600);
    });
  }

  // ============================================
  // Hunt Activation
  // ============================================
  async function activateHunt() {
    // Play mysterious cipher animation BEFORE showing hunt
    await playCipherAnimation();
    
    await playTransition();
    
    if (overlay) overlay.setAttribute('data-active', 'true');
    isActive = true;
    
    loadProgress();
    renderCurrentStage();
    updateProgress();
    updateNavigation();
    
    // Initialize image trail for completed puzzles
    await initImageTrail('stage-container');
  }

  function deactivateHunt() {
    // Stop and destroy image trail
    stopTrail();
    destroyImageTrail();
    
    // Stop music
    stopMusic();
    
    // Destroy pass bypass
    destroyPassBypass();
    
    if (overlay) overlay.setAttribute('data-active', 'false');
    isActive = false;
    
    // Clear slider cache
    slideCache.clear();
    if (stageSlider) stageSlider.innerHTML = '';
    
    if (lenisInstance) {
      lenisInstance.destroy();
      lenisInstance = null;
    }
  }

  // ============================================
  // Progress & Navigation
  // ============================================
  function saveProgress() {
    localStorage.setItem(STORAGE_KEY, currentStageIndex.toString());
    localStorage.setItem(SOLVED_KEY, JSON.stringify([...solvedStages]));
  }

  function loadProgress() {
    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved) {
      const idx = parseInt(saved, 10);
      if (!isNaN(idx) && idx < huntStages.length) {
        currentStageIndex = idx;
      }
    }
    
    const savedSolved = localStorage.getItem(SOLVED_KEY);
    if (savedSolved) {
      try {
        solvedStages = new Set(JSON.parse(savedSolved));
      } catch {
        solvedStages = new Set();
      }
    }
  }

  function updateProgress() {
    const total = huntStages.length;
    const current = currentStageIndex + 1;
    if (progressText) progressText.textContent = `[${current}/${total}]`;
    if (progressFill) progressFill.style.width = `${(current / total) * 100}%`;
    saveProgress();
  }

  function updateNavigation() {
    if (!navPrev || !navNext) return;
    
    const prevBtn = navPrev as HTMLButtonElement;
    const nextBtn = navNext as HTMLButtonElement;
    
    // In debug mode, allow free navigation
    if (DEBUG_MODE) {
      prevBtn.disabled = currentStageIndex === 0;
      nextBtn.disabled = currentStageIndex >= huntStages.length - 1;
      return;
    }
    
    // Can go prev if not at start
    prevBtn.disabled = currentStageIndex === 0;
    
    // Can go next if current is solved and not at end
    const currentSolved = solvedStages.has(currentStageIndex);
    nextBtn.disabled = !currentSolved || currentStageIndex >= huntStages.length - 1;
  }

  // Navigation handlers
  if (navPrev) {
    navPrev.addEventListener('click', async () => {
      if (currentStageIndex > 0) {
        await goToStage(currentStageIndex - 1, 'prev');
      }
    });
  }

  if (navNext) {
    navNext.addEventListener('click', async () => {
      // In debug mode, allow navigation without solving
      if (DEBUG_MODE && currentStageIndex < huntStages.length - 1) {
        await goToStage(currentStageIndex + 1, 'next');
      } else if (currentStageIndex < huntStages.length - 1 && solvedStages.has(currentStageIndex)) {
        await goToStage(currentStageIndex + 1, 'next');
      }
    });
  }

  async function goToStage(index: number, direction: 'next' | 'prev' = 'next') {
    if (isSliding) return; // Prevent multiple simultaneous transitions
    isSliding = true;
    
    const previousIndex = currentStageIndex;
    currentStageIndex = index;
    stagePhase = solvedStages.has(index) ? 'memory' : 'puzzle';
    
    // Render the new stage if not already cached (going forward)
    if (!slideCache.has(index)) {
      renderStageToSlide(index);
    }
    
    // Animate the slide transition
    await slideToStage(previousIndex, index, direction);
    
    updateProgress();
    updateNavigation();
    
    isSliding = false;
  }

  // ============================================
  // Show Success Message
  // ============================================
  function showSuccessMessage(message: string): Promise<void> {
    return new Promise((resolve) => {
      if (!successMessage || !successOverlay) { resolve(); return; }
      
      successMessage.textContent = message;
      successOverlay.classList.add('active');
      
      gsap.fromTo(successMessage, 
        { opacity: 0, y: 20 },
        { opacity: 1, y: 0, duration: 0.4 }
      );

      setTimeout(() => {
        gsap.to(successOverlay, {
          opacity: 0,
          duration: 0.4,
          onComplete: () => {
            successOverlay.classList.remove('active');
            gsap.set(successOverlay, { opacity: 1 });
            resolve();
          }
        });
      }, 1800);
    });
  }

  // ============================================
  // Slider Management Functions
  // ============================================
  
  /**
   * Render a stage to a slide element and cache it
   */
  function renderStageToSlide(stageIndex: number): HTMLElement | null {
    const stage = huntStages[stageIndex];
    if (!stage || !stageSlider) return null;

    // Create slide container
    const slide = document.createElement('div');
    slide.className = 'stage-slide';
    slide.dataset.stageIndex = stageIndex.toString();
    
    // Render content based on stage type
    const content = renderStageContent(stageIndex);
    slide.innerHTML = content;
    
    // Add to slider
    stageSlider.appendChild(slide);
    
    // Cache the slide
    slideCache.set(stageIndex, slide);
    
    // Initialize interactions after a short delay to ensure DOM is ready
    setTimeout(() => {
      initStageInteractions(stageIndex, slide);
    }, 50);
    
    return slide;
  }
  
  /**
   * Preload adjacent stages for smooth transitions
   */
  function preloadAdjacentStages(currentIndex: number) {
    // Preload previous stage
    if (currentIndex > 0 && !slideCache.has(currentIndex - 1)) {
      renderStageToSlide(currentIndex - 1);
    }
    
    // Preload next stage
    if (currentIndex < huntStages.length - 1 && !slideCache.has(currentIndex + 1)) {
      renderStageToSlide(currentIndex + 1);
    }
  }
  
  /**
   * Clean up slides that are far from current position
   */
  function cleanupDistantSlides(currentIndex: number) {
    const keepRange = 2; // Keep current + 2 on each side
    
    slideCache.forEach((slide, index) => {
      if (Math.abs(index - currentIndex) > keepRange) {
        slide.remove();
        slideCache.delete(index);
      }
    });
  }
  
  /**
   * Animate sliding to a specific stage using CSS transform
   */
  async function slideToStage(fromIndex: number, toIndex: number, direction: 'next' | 'prev'): Promise<void> {
    if (!stageSlider) return;
    
    const toSlide = slideCache.get(toIndex);
    if (!toSlide) return;
    
    // Calculate the position to slide to (each slide is 100vw)
    // We need to find the actual DOM position of the target slide
    const slides = Array.from(stageSlider.children) as HTMLElement[];
    const targetSlideIndex = slides.indexOf(toSlide);
    
    if (targetSlideIndex === -1) return;
    
    // Slide the track to show the target slide
    const offset = targetSlideIndex * 100;
    stageSlider.style.transform = `translateX(-${offset}vw)`;
    
    // Reset bypass progress after transition
    resetBypassProgress();
    
    // Update image trail
    const isStageSolved = solvedStages.has(toIndex);
    const stage = huntStages[toIndex];
    if (isStageSolved && stage.type === 'puzzle') {
      startTrail();
    } else {
      stopTrail();
    }
  }
  
  /**
   * Initial render - sets up the slider with all stages up to current
   */
  function renderCurrentStage() {
    if (!stageSlider) return;
    
    // Clear existing content
    stageSlider.innerHTML = '';
    slideCache.clear();
    
    // Clean up previous Lenis
    if (lenisInstance) {
      lenisInstance.destroy();
      lenisInstance = null;
    }
    
    // Render all stages from 0 to current (for carousel to work)
    // Each solved stage + the current unsolved one
    for (let i = 0; i <= currentStageIndex; i++) {
      renderStageToSlide(i);
    }
    
    // Set initial carousel position to show current stage
    const offset = currentStageIndex * 100;
    stageSlider.style.transform = `translateX(-${offset}vw)`;
    
    // Check if current stage is solved (for image trail)
    const isStageSolved = solvedStages.has(currentStageIndex);
    const stage = huntStages[currentStageIndex];
    if (isStageSolved && stage.type === 'puzzle') {
      startTrail();
    } else {
      stopTrail();
    }
  }
  
  /**
   * Generate HTML content for a stage (extracted from switch statement)
   */
  function renderStageContent(stageIndex: number): string {
    const stage = huntStages[stageIndex];
    if (!stage) return '';
    
    // Reset bypass progress when switching stages
    resetBypassProgress();

    switch (stage.type) {
      case 'puzzle':
        return generatePuzzleHTML(stage, stageIndex);
      case 'glitch_puzzle':
        return generateGlitchPuzzleHTML(stage, stageIndex);
      case 'crossword':
        return generateCrosswordHTML(stage, stageIndex);
      case 'responsive_squeeze':
        return generateResponsiveSqueezeHTML(stage, stageIndex);
      case 'emoji_puzzle':
        return generateEmojiPuzzleHTML(stage, stageIndex);
      case 'invisible_ink':
        return generateInvisibleInkHTML(stage, stageIndex);
      case 'love_wordle':
        return generateLoveWordleHTML(stage, stageIndex);
      case 'fake_404':
        return generateFake404HTML(stage, stageIndex);
      case 'captcha_puzzle':
        return generateCaptchaHTML(stage, stageIndex);
      case 'date_gate':
        return generateDateGateHTML(stage, stageIndex);
      case 'video_reveal':
        return generateVideoRevealHTML(stage, stageIndex);
      default:
        return generatePuzzleHTML(stage, stageIndex);
    }
  }
  
  /**
   * Initialize interactions for a rendered stage
   */
  function initStageInteractions(stageIndex: number, slideElement: HTMLElement) {
    const stage = huntStages[stageIndex];
    if (!stage) return;
    
    // Set the context to the specific slide for queries
    const previousContainer = stageContainer;
    
    // Temporarily override stageContainer to point to this slide
    // This ensures all the existing init functions work with the slide
    (window as any).__currentSlideContext = slideElement;
    
    switch (stage.type) {
      case 'puzzle':
        initPuzzleInteractionsInSlide(stage, slideElement, stageIndex);
        break;
      case 'glitch_puzzle':
        initGlitchPuzzleInSlide(stage, slideElement, stageIndex);
        break;
      case 'crossword':
        initCrosswordInSlide(stage, slideElement, stageIndex);
        break;
      case 'responsive_squeeze':
        initResponsiveSqueezeInSlide(stage, slideElement, stageIndex);
        break;
      case 'emoji_puzzle':
        initEmojiPuzzleInSlide(stage, slideElement, stageIndex);
        break;
      case 'invisible_ink':
        initInvisibleInkInSlide(stage, slideElement, stageIndex);
        break;
      case 'love_wordle':
        initLoveWordleInSlide(stage, slideElement, stageIndex);
        break;
      case 'fake_404':
        initFake404InSlide(stage, slideElement, stageIndex);
        break;
      case 'captcha_puzzle':
        initCaptchaInSlide(stage, slideElement, stageIndex);
        break;
      case 'date_gate':
        initDateGateInSlide(stage, slideElement, stageIndex);
        break;
      case 'video_reveal':
        initVideoRevealInSlide(stage, slideElement, stageIndex);
        break;
    }
    
    (window as any).__currentSlideContext = null;
  }

  // ============================================
  // HTML Generation Functions for Each Puzzle Type
  // ============================================
  
  /**
   * Generate HTML for standard puzzle stage
   */
  function generatePuzzleHTML(stage: any, stageIndex: number): string {
    const isSolved = solvedStages.has(stageIndex);
    const memories = stage.memories || [];
    
    const puzzleHtml = `
      <div class="puzzle-section ${isSolved ? 'solved' : ''}" id="puzzle-section-${stageIndex}">
        <div class="puzzle-card">
          <div class="terminal-frame">
            <div class="terminal-header">
              <div class="terminal-dots">
                <span class="dot red"></span>
                <span class="dot yellow"></span>
                <span class="dot green"></span>
              </div>
              <span class="terminal-title">✧ puzzle ${stageIndex + 1} ✧</span>
            </div>
            <div class="terminal-content">
              ${isSolved ? `
                <div class="puzzle-prompt">${stage.prompt}</div>
                <div class="solved-answer">✓ ${stage.answer}</div>
              ` : `
                <div class="puzzle-prompt" id="puzzle-prompt-${stageIndex}"></div>
                <div class="puzzle-subtext" id="puzzle-subtext-${stageIndex}"></div>
                ${stage.imageClue ? `<div class="puzzle-image"><img src="${stage.imageClue}" alt="Clue" /></div>` : ''}
                <form class="puzzle-form" id="puzzle-form-${stageIndex}">
                  <div class="puzzle-input-wrapper">
                    <span class="puzzle-cursor">♡</span>
                    <input 
                      type="${stage.inputType === 'numeric' ? 'tel' : 'text'}" 
                      id="puzzle-input-${stageIndex}" 
                      class="puzzle-input"
                      placeholder="${stage.inputPlaceholder || 'your answer...'}"
                      autocomplete="off"
                      autocorrect="off"
                      spellcheck="false"
                    />
                    <button type="submit" class="puzzle-submit">Submit</button>
                  </div>
                  <div class="puzzle-error" id="puzzle-error-${stageIndex}"></div>
                </form>
                ${stage.hint ? `
                  <div class="hint-container">
                    <button type="button" class="hint-toggle" id="hint-toggle-${stageIndex}">need a hint?</button>
                    <div class="hint-text" id="hint-text-${stageIndex}">${stage.hint}</div>
                  </div>
                ` : ''}
              `}
            </div>
          </div>
        </div>
      </div>
    `;

    const memoriesHtml = memories.length > 0 ? `
      <div class="memories-section ${isSolved ? 'visible' : ''}" id="memories-section-${stageIndex}">
        ${stage.memoriesMessage ? `<p class="memories-message">${stage.memoriesMessage}</p>` : ''}
        <div class="memories-container" id="memories-container-${stageIndex}">
          ${memories.map((mem: any, i: number) => `
            <div class="memory-card" data-index="${i}" data-speed="${0.3 + (i % 3) * 0.1}">
              <div class="memory-card-inner">
                <img class="static-image" src="${typeof mem === 'string' ? mem : mem.image}" alt="Memory ${i + 1}" 
                     onerror="this.src='https://picsum.photos/400/600?random=${i}'" />
                ${(typeof mem === 'object' && mem.livePhoto) ? `<img class="live-photo" src="${mem.livePhoto}" alt="" />` : ''}
                <div class="memory-frame"></div>
                <span class="memory-index">${String(i + 1).padStart(2, '0')}</span>
              </div>
            </div>
          `).join('')}
        </div>
        <button class="continue-btn" id="continue-btn-${stageIndex}">Next →</button>
      </div>
    ` : '';

    return puzzleHtml + memoriesHtml;
  }
  
  /**
   * Initialize interactions for puzzle in slide
   */
  function initPuzzleInteractionsInSlide(stage: any, slideElement: HTMLElement, stageIndex: number) {
    const isSolved = solvedStages.has(stageIndex);
    
    if (!isSolved) {
      const promptEl = slideElement.querySelector(`#puzzle-prompt-${stageIndex}`) as HTMLElement;
      const subtextEl = slideElement.querySelector(`#puzzle-subtext-${stageIndex}`) as HTMLElement;
      const form = slideElement.querySelector(`#puzzle-form-${stageIndex}`) as HTMLFormElement;
      const input = slideElement.querySelector(`#puzzle-input-${stageIndex}`) as HTMLInputElement;
      const errorEl = slideElement.querySelector(`#puzzle-error-${stageIndex}`) as HTMLElement;
      const hintToggle = slideElement.querySelector(`#hint-toggle-${stageIndex}`) as HTMLElement;
      const hintText = slideElement.querySelector(`#hint-text-${stageIndex}`) as HTMLElement;
      const puzzleSection = slideElement.querySelector(`#puzzle-section-${stageIndex}`) as HTMLElement;
      const memoriesSection = slideElement.querySelector(`#memories-section-${stageIndex}`) as HTMLElement;

      // Initialize PASS bypass for this puzzle
      initPassBypass(() => {
        if (form && input) {
          const correctAnswer = Array.isArray(stage.answer) ? stage.answer[0] : stage.answer;
          input.value = correctAnswer;
          form.dispatchEvent(new Event('submit', { cancelable: true }));
        }
      });

      // Typewriter effect
      if (promptEl && stage.prompt) {
        typewriterEffect(promptEl, stage.prompt, 40, () => {
          if (subtextEl && stage.subtext) {
            typewriterEffect(subtextEl, stage.subtext, 25, () => {
              if (input) input.focus();
            });
          } else if (input) {
            input.focus();
          }
        });
      }

      // Numeric input filter
      if (stage.inputType === 'numeric' && input) {
        input.addEventListener('input', (e) => {
          const target = e.target as HTMLInputElement;
          target.value = target.value.replace(/[^0-9]/g, '');
        });
      }

      // Hint toggle
      if (hintToggle && hintText) {
        hintToggle.addEventListener('click', () => {
          hintText.classList.toggle('visible');
          hintToggle.textContent = hintText.classList.contains('visible') ? 'hide hint' : 'need a hint?';
        });
      }

      // Form submission
      if (form && input) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          
          const userAnswer = stage.inputType === 'text'
            ? input.value.toLowerCase().trim()
            : input.value.trim();
          
          const correctAnswers = Array.isArray(stage.answer) 
            ? stage.answer 
            : [stage.answer];
          
          const isCorrect = correctAnswers.some((ans: any) => {
            const normalizedAns = stage.inputType === 'text' 
              ? ans.toLowerCase().trim() 
              : ans.trim();
            return userAnswer === normalizedAns;
          });

          if (isCorrect) {
            solvedStages.add(stageIndex);
            saveProgress();
            updateNavigation();
            await showSuccessMessage(stage.successMessage || 'Correct! ♡');

            if (puzzleSection) {
              gsap.to(puzzleSection, {
                scale: 0.92,
                opacity: 0.7,
                duration: 0.5
              });
              puzzleSection.classList.add('solved');
            }

            if (memoriesSection) {
              memoriesSection.classList.add('visible');
              initMemoryInteractionsInSlide(slideElement, stageIndex);
              initContinueButtonInSlide(slideElement, stageIndex);
            }
          } else {
            gsap.to(puzzleSection.querySelector('.puzzle-card'), {
              x: -8,
              duration: 0.4,
              ease: 'power2.inOut',
              repeat: 3,
              yoyo: true
            });
            
            if (errorEl) {
              errorEl.textContent = `not quite... try again ♡`;
              errorEl.style.opacity = '1';
            }
            
            input.value = '';
            input.focus();
          }
        });
      }
      
      // Preload memory images
      preloadMemoryImages(stage.memories || []);
    } else {
      initMemoryInteractionsInSlide(slideElement, stageIndex);
      initContinueButtonInSlide(slideElement, stageIndex);
    }
  }

  /**
   * Initialize memory interactions within a slide
   */
  function initMemoryInteractionsInSlide(slideElement: HTMLElement, stageIndex: number) {
    const memoriesContainer = slideElement.querySelector(`#memories-container-${stageIndex}`) as HTMLElement;
    if (!memoriesContainer) return;

    const cards = memoriesContainer.querySelectorAll('.memory-card');
    if (cards.length === 0) return;

    // Tilt effect and live photo on each card
    cards.forEach((card, index) => {
      const inner = card.querySelector('.memory-card-inner');
      const staticImg = card.querySelector('.static-image');
      const livePhoto = card.querySelector('.live-photo');
      
      card.addEventListener('mousemove', ((e: MouseEvent) => {
        const rect = card.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        
        gsap.to(inner, {
          rotateX: y * -12,
          rotateY: x * 12,
          scale: 1.02,
          duration: 0.3,
          ease: 'power2.out'
        });
      }) as EventListener);

      card.addEventListener('mouseleave', () => {
        gsap.to(inner, {
          rotateX: 0,
          rotateY: 0,
          scale: 1,
          duration: 0.5,
          ease: 'power2.out'
        });

        if (livePhoto) {
          gsap.to(livePhoto, { opacity: 0, duration: 0.3 });
        }
        if (staticImg) {
          gsap.to(staticImg, { opacity: 1, duration: 0.3 });
        }
      });

      card.addEventListener('mouseenter', () => {
        if (livePhoto) {
          gsap.to(livePhoto, { opacity: 1, duration: 0.3 });
          gsap.to(staticImg, { opacity: 0, duration: 0.3 });
        }
      });

      gsap.fromTo(card,
        { opacity: 0, y: 50 },
        { 
          opacity: 1, 
          y: 0, 
          duration: 0.6,
          delay: 0.1 * index,
          ease: 'power2.out'
        }
      );
    });
  }
  
  /**
   * Initialize continue button within a slide
   */
  function initContinueButtonInSlide(slideElement: HTMLElement, stageIndex: number) {
    const btn = slideElement.querySelector(`#continue-btn-${stageIndex}`) as HTMLButtonElement;
    if (!btn) return;

    btn.addEventListener('click', async () => {
      if (stageIndex < huntStages.length - 1) {
        await goToStage(stageIndex + 1, 'next');
      }
    });
  }

