  function initGlitchPuzzleInSlide(stage: any, slideElement: HTMLElement, stageIndex: number) {
    // Initialize PASS bypass
    const form = slideElement.querySelector(`#puzzle-form-${stageIndex}`) as HTMLFormElement;
