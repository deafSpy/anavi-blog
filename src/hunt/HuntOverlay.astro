    const targetWidth = stage.targetWidth || 500;
    let hasRevealed = false;

    function checkWidth() {
      const width = window.innerWidth;
      if (widthEl) widthEl.textContent = width.toString();

      if (width < targetWidth && !hasRevealed) {
        hasRevealed = true;
        solvedStages.add(currentStageIndex);
        saveProgress();
        updateNavigation();

        // Show success message
        showSuccessMessage(stage.successMessage || 'Perfect! ♡').then(() => {
          // Reveal code
          if (statusEl) statusEl.style.display = 'none';
          if (revealEl) revealEl.style.display = 'block';
          
          gsap.from(revealEl, {
            opacity: 0,
            y: 20,
            duration: 0.6,
            ease: 'power2.out'
          });
        });
      }
    }

    checkWidth();
    window.addEventListener('resize', checkWidth);

    // Initialize PASS bypass for responsive squeeze
    initPassBypass(() => {
      // Trigger the win condition
      hasRevealed = true;
      solvedStages.add(currentStageIndex);
      saveProgress();
      updateNavigation();

      showSuccessMessage(stage.successMessage || 'Perfect! ♡').then(() => {
        if (statusEl) statusEl.style.display = 'none';
        if (revealEl) revealEl.style.display = 'block';
        
        gsap.from(revealEl, {
          opacity: 0,
          y: 20,
          duration: 0.6,
          ease: 'power2.out'
        });
      });
    });

    // Continue button
    if (continueBtn) {
      continueBtn.addEventListener('click', async () => {
        window.removeEventListener('resize', checkWidth);
        if (currentStageIndex < huntStages.length - 1) {
          await goToStage(currentStageIndex + 1, 'next');
        }
      });
    }
  }

